  "purpose": "Continue the mature Jev-directed musical-relational investigation and test its hypotheses across source-native system hierarchies in SUNNY's intended common geometric structure. Preserve continuity and progressively derived comparison/type capabilities while pursuing the explicit calendar and symbol/sound outcomes. Parallel historical forensics repairs omitted, misinterpreted or incorrectly carried relationships; it is not the whole assignment.",
  "original_two_purposes": [
    "Solve contextual continuity failures, including forgotten discoveries, decisions, questions and their dependencies.",
    "Equip the investigation with a progressively derived typed system for recognizing musical-geometric patterns, operators and dynamics in other systems, equations, traditions and mathematical bodies."
  ],
  "working_premises": {
    "musical_reference": "Complete native mathematical, structural, operational, harmonic, temporal, compositional and orchestral relations of music are SUNNY's deterministic reference, not only a scalar equation or finite carrier.",
    "intended_geometry": "The complete intended geometry, systemic/generational wheels, two rotations per class before lift and Sierpinski-tetrahedral Monad at infinitum remain the adopted working premise. Exact realizations, mappings and consequences must be recovered and tested within that premise.",
    "host_boundary": "The host must not replace these premises with its preferred research mission. Jev-directed investigation and faithful source/derivation accounting remain required; a Jev preference is not a mathematical proof."
  },
  "investigation_tracks": [
    {
      "id": "calendar_counterfactuals",
      "role": "explicit_overarching_outcome",
      "question": "Rectify date/time from the relevant historical perspectives by comparing uninterrupted institutional use with scenarios affected by specified calendar-system changes.",
      "preserve": ["epoch", "calendar rule", "intervention sequence", "institutional use", "date label", "elapsed duration", "astronomical or other independent anchor", "location/reference frame", "year numbering and day boundary"],
      "do_not_preselect": "A unique modern label, calendar lineage, reform history or historical culprit."
    },
    {
      "id": "symbol_sound_transmission",
      "role": "explicit_overarching_outcome_and_hypothesized_cascade",
      "question": "Rectify sacred-symbol representation and intended phonetic transmission; test whether corrected symbol/sound relationships resolve other alignments and messages.",
      "priority_comparison": ["Paleo-Hebrew", "Aramaic", "English"],
      "additional_comparison": ["Greek", "Latin", "other source-relevant systems"],
      "preserve": ["actual glyph", "script/grapheme", "alphabet order", "letter name", "numerical mapping", "dated pronunciation alternatives", "transliteration", "word/morphology", "meaning", "acoustic/musical operation"],
      "do_not_preselect": "An intended original phoneme inventory, hidden message, identity from a numerical collision or modern bloodline. The anticipated cascade remains a hypothesis to investigate."
    },
    {
      "id": "mature_alignment",
      "role": "continuing_primary_investigation",
      "question": "Formalize and align the native hierarchies already participating in the investigation, test other candidate systems and locate exactly which relations are preserved or diverge in the common structure.",
      "domains": ["Western music", "Chinese music", "other participating musical candidates", "cosmological and cosmogonical traditions", "biblical people and timelines", "zodiacal systems", "mathematical and scientific systems", "color scales", "DNA and biology", "esoteric and Tree of Life systems", "alphabets", "number systems"],
      "witness_preference": "Prioritize the oldest recorded accounts as requested; distinguish composition, surviving witness, edition and translation and retain variants rather than treating a later taxonomy as the original.",
      "do_not_preselect": "A common label or numerical total as an identity or a lawful adapter."
    },
    {
      "id": "targeted_forensic_repair",
      "role": "parallel_supporting_investigation",
      "question": "Trace historical decisions, omissions, questions and improperly carried material, including before terminology was formalized, to repair dependencies relevant to the active investigation.",
      "whole_history_completion_is_universal_gate": false,
      "dependency_policy": "Pause only the deduction that actually requires a missing premise; continue independent mature work. Preserve meaningful prior discoveries, corrections and scoped results."
    }
  ],
  "musical_bridge_policy": {
    "native_systems_retained": ["Western", "Chinese"],
    "retained_bridge_history": ["Fludd/Kepler monochord", "Completed Harmony", "Tree of Life adapter", "TOL AB/BA"],
    "full_stack": "Keep the recovered native systems and source-qualified bridge compositions available and usable on their actual domains.",
    "held_aside_trial": "A declared experiment may withhold an adapter or target attribution while deriving music-native consequences, then compare the result at the stated higher level.",
    "experiment_manifest_required": ["question", "included inputs/rules", "held-aside relationships", "candidate adapter versions", "prediction or conditional result", "evaluation evidence", "exposure status"],
    "neither_always_apply_nor_permanently_delete": true,
    "missing_signature_policy": "Literal unretrieved A/B definitions remain localized dependencies; do not substitute R/L or erase the retained bridge."
