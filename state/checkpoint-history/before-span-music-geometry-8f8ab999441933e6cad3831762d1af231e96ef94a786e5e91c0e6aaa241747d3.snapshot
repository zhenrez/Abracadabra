    {
      "id": "MG-CN-C08",
      "kind": "native_chinese_pilot_claim",
      "status": "source_reported_pilot_result",
      "statement": "Distinct transformations — Lam's `T_n` changes the twelve-class set key while holding tone position; `t_n` changes the five-position index while holding the set key.",
      "source_refs": [
        "32709e8763ac228cadc7cf5ef11c73eca6ada4257030855cc343ed4279474097"
      ],
      "evidence": [
        {
          "source_id": "32709e8763ac228cadc7cf5ef11c73eca6ada4257030855cc343ed4279474097",
          "source_sha256": "66e5d2d763e55411993bfcf4ad07ca4cc0a708f624264e226abf51b90531e9dd",
          "locator": "utf8chars:[3538,3743)",
