      "id": "MG-M-MEC-10",
      "native_id": "MEC-10",
      "kind": "native_mechanism",
      "status": "FROZEN_EQUIVALENCE_CLASS",
      "assertion_layer": "retained native research record; not newly independently validated",
      "statement": "CONDITIONAL_NEXT_EVENT_KERNEL",
      "source_refs": [
        "9e03168cabf04e3887245d93c75f1f9d0034a53bead61e5d8b5a5e0315b259e8"
      ],
      "value": {
        "id": "MEC-10",
        "name": "CONDITIONAL_NEXT_EVENT_KERNEL",
        "canonical": "K(context,y)=P(next=y | context)",
        "members": [
          {
            "system": "Xenakis Markovian systems",
            "objects": [
              "first-order transition probability"
            ],
            "relation": "context = preceding state"
          },
          {
            "system": "IDyOM-style expectation",
            "objects": [
              "next-event distribution"
            ],
            "relation": "variable learned sequential context"
          }
        ],
        "proved_relations": [
          "first-order Markov is the context-length-1 special case",
          "IDyOM-style expectation is a conditional next-event distribution over richer context"
        ],
        "status": "FROZEN_EQUIVALENCE_CLASS"
      },
      "evidence": [
