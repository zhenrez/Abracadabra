          "quote": "{\n      \"id\": \"MEC-01\",\n      \"name\": \"SCALAR_MULTIPLICATIVE_ACTION\",\n      \"canonical\": \"S_c(x)=c x, c>0\",\n      \"members\": [\n        {\n          \"system\": \"SUN scalar kernel\",\n          \"objects\": [\n            \"R=2/3\",\n            \"L=3/4\",\n            \"O=RL=1/2\"\n          ],\n          \"relation\": \"NATIVE\"\n        },\n        {\n          \"system\": \"sanfen sunyi\",\n          \"objects\": [\n            \"D=2/3\",\n            \"U=4/3\"\n          ],\n          \"relation\": \"EXACT_GENERATOR_FAMILY_EQUIVALENCE to SUN on positive scalar carrier\"\n        },\n        {\n          \"system\": \"Zhu equal division\",\n          \"objects\": [\n            \"q=2^(1/12)\"\n          ],\n          \"relation\": \"ROOT_EXTENSION / SAME OPERATION FORM, NOT SAME SUBGROUP\"\n        },\n        {\n          \"system\": \"Messiaen augmentation/diminution\",\n          \"objects\": [\n            \"duration scaling c and c^-1\"\n          ],\n          \"relation\": \"SAME OPERATION FORM, DIFFERENT CARRIER/SEMANTICS\"\n        }\n      ],\n      \"proved_relations\": [\n        \"<R,L> = {2^a 3^b} \\u2245 Z^2\",\n        \"sanfen D=R and U=L^-1\",\n        \"q not in <R,L> but q^12=2\",\n        \"O=RL is constructible\"\n      ],\n      \"status\": \"FROZEN_EQUIVALENCE_CLASS\"\n    }",
          "quote_sha256": "396575440764ec5f8e2ba41ecb082399d118d688ff15ca971abd6e39d5d2b0e4",
