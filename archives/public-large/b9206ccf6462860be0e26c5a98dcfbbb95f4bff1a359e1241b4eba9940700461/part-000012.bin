        {
          "id": "bible:theographic:abdon_10",
          "nativeName": "Abdon",
          "name": "Abdon",
          "aliases": [],
          "unit": "Curated Biblical named-entity/person record",
          "sourceRecordKey": "abdon_10",
          "sourceRecordOrdinalOneBased": 9,
