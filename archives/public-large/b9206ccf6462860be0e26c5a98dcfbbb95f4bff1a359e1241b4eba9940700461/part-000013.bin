          "witnessId": "Theographic-KJV-comparison",
          "position": {
            "generation": null,
            "sequence": 2377,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "assertionLayer": "curator-or-textual-occurrence",
          "exceptions": [
            "Ram ((Hebrew: אֲרָם Aram) is a son of Shem, according to the Table of Nations in Genesis 10 of the Hebrew Bible, and the father of Uz, Hul, Gether and Mash or Meshech.[1] The Book of Chronicles lists Aram, Uz, Hul, Gether, and Meshech as descendants of Shem, although without stating explicitly that Aram is the father of the other four.[2] Aram is usually regarded as being the eponymous ancestor of the Aramean people of Northern Mesopotamia and Syria.)"
          ],
