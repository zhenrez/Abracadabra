          ],
          "sourceInteger": 174762,
          "sourceIntegerSpelling": "十七萬四千七百六十二",
          "sourceLengthCunRatio": "19418/2187",
          "exactIdealLengthCunRatio": "524288/59049",
          "idealFrequencyRelativeHuangzhong": "531441/524288",
          "physicalFrequencyHz": null,
          "sourceEntry": {
            "sourceId": "chinese-expanded:houhan91",
            "normalizedTextPath": "state/research/chinese-expanded/houhan91.normalized.txt",
            "startCodePoint": 7355,
            "endCodePointExclusive": 7418,
            "text": "執始，十七萬四千七百六十二。下生去滅。執始為宮，時息商，去滅徵。 六日律，八寸八分小分七大強。準，八尺八寸萬五千五百一十六。 "
          },
          "lengthAndZhunText": "律，八寸八分小分七大強。準，八尺八寸萬五千五百一十六。",
