        {
          "id": "music:chinese:zhouli",
          "nativeName": "周禮注疏 卷23 witness",
          "aliases": [],
          "unit": "native-text-musical-system",
          "tradition": "Chinese",
          "witnessId": "ZhouLi-ZhuShu23",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "sourceRefs": [
            "music:source:zhouli_zhushu23"
          ],
          "exceptions": [],
          "assertionLayer": "source-assertion",
          "evidence": {
            "sourceId": "music:source:zhouli_zhushu23",
            "normalization": "HTMLParser data joined by spaces; consecutive whitespace collapsed",
            "normalizedTextChars": [
              15088,
              15141
            ],
            "quote": "陽聲黄鍾大蔟姑洗蕤賓夷則無射陰聲大呂應鍾南呂函鍾小呂夾鍾皆文之以五聲宮商角徴羽皆播之以八音金石土革絲木匏竹",
            "quoteSha256": "01562942e2fccde3e80b106864e3230ef28765bdf043138e3fd2b7a9752bc00a"
          }
        },
