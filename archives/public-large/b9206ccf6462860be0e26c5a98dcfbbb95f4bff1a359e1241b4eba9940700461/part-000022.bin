        {
          "id": "chinese-expanded:houhan:standard:黃鐘",
          "nativeName": "黃鐘",
          "aliases": [],
          "unit": "JingFang-witness-named-lu-standard",
          "tradition": "Chinese",
          "witnessId": "HouHanShu91-JingFang",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "sourceRefs": [
            "chinese-expanded:houhan91"
          ],
          "assertionLayer": "source-assertion",
          "exceptions": [
            "Exact ideal string/pipe inverse-length ratios are conditional on common wave speed and ideal acoustic boundary; source integers/units remain separately preserved."
          ],
          "sourceInteger": 177147,
          "sourceIntegerSpelling": "十七萬七千一百四十七",
          "sourceLengthCunRatio": "9",
          "exactIdealLengthCunRatio": "9",
          "idealFrequencyRelativeHuangzhong": "1",
          "physicalFrequencyHz": null,
          "sourceEntry": {
            "sourceId": "chinese-expanded:houhan91",
            "normalizedTextPath": "state/research/chinese-expanded/houhan91.normalized.txt",
            "startCodePoint": 7248,
            "endCodePointExclusive": 7292,
            "text": "黃鐘，十七萬七千一百四十七。下生林鐘。黃鐘為宮，太蔟商，林鐘徵。 一日律九寸，準九尺。 "
          },
          "lengthAndZhunText": "律九寸，準九尺。",
          "dayDurationAsPrinted": 1,
          "nativeCoordinates": {
            "sourceLengthOrderIndex": 0,
            "generationOrderIndex": 0
          }
        },
        {
          "id": "chinese-expanded:houhan:standard:色育",
          "nativeName": "色育",
          "aliases": [],
          "unit": "JingFang-witness-named-lu-standard",
          "tradition": "Chinese",
          "witnessId": "HouHanShu91-JingFang",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "sourceRefs": [
            "chinese-expanded:houhan91"
          ],
          "assertionLayer": "source-assertion",
          "exceptions": [
            "Exact ideal string/pipe inverse-length ratios are conditional on common wave speed and ideal acoustic boundary; source integers/units remain separately preserved."
          ],
          "sourceInteger": 176776,
          "sourceIntegerSpelling": "十七萬六千七百七十六",
          "sourceLengthCunRatio": "176776/19683",
          "exactIdealLengthCunRatio": "19342813113834066795298816/2153693963075557766310747",
          "idealFrequencyRelativeHuangzhong": "19383245667680019896796723/19342813113834066795298816",
          "physicalFrequencyHz": null,
          "sourceEntry": {
            "sourceId": "chinese-expanded:houhan91",
            "normalizedTextPath": "state/research/chinese-expanded/houhan91.normalized.txt",
            "startCodePoint": 7292,
            "endCodePointExclusive": 7355,
            "text": "色育，十七萬六千七百七十六。下生謙待。色育為宮，未知商，謙待徵。 六日律，八寸九分小分八微強。準，八尺九寸萬五千九百七十三。 "
          },
          "lengthAndZhunText": "律，八寸九分小分八微強。準，八尺九寸萬五千九百七十三。",
          "dayDurationAsPrinted": 6,
          "nativeCoordinates": {
            "sourceLengthOrderIndex": 1,
            "generationOrderIndex": 53
          }
        },
        {
          "id": "chinese-expanded:houhan:standard:執始",
          "nativeName": "執始",
          "aliases": [],
          "unit": "JingFang-witness-named-lu-standard",
          "tradition": "Chinese",
          "witnessId": "HouHanShu91-JingFang",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
