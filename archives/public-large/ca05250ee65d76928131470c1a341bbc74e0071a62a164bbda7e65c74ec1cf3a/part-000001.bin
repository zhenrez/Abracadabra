ce":{"sourceId":"upload-5331e05d23393b76e4867e8223573dab6d48bc4b9d2cd76bfc7b4b96026008a1","pixelBounds":[645,750,1225,1420],"reading":null,"boundsKind":"approximate-panel-context; not an OCR glyph bounding box","transcriptionStatus":"visually-inspected","method":"Actual view_image original-resolution inspection; not an OCR or source-truth certification."}},{"id":"music:chinese:image-element:4","nativeName":"Wood","aliases":[],"unit":"image-five-element-category","tradition":"Chinese comparison witness","witnessId":"musi19","position":{"generation":null,"sequence":4,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["upload-5331e05d23393b76e4867e8223573dab6d48bc4b9d2cd76bfc7b4b96026008a1"],"exceptions":["Creates/destroys labels are visible; complete directed-arrow transcription is pending, so none is fabricated here."],"assertionLayer":"source-assertion","evidence":{"sourceId":"upload-5331e05d23393b76e4867e8223573dab6d48bc4b9d2cd76bfc7b4b96026008a1","pixelBounds":[645,750,1225,1420],"reading":null,"boundsKind":"approximate-panel-context; not an OCR glyph bounding box","transcriptionStatus":"visually-inspected","method":"Actual view_image original-resolution inspection; not an OCR or source-truth certification."}},{"id":"music:chinese:lushi","nativeName":"呂氏春秋 音律 witness","aliases":[],"unit":"native-text-musical-system","tradition":"Chinese","witnessId":"LuShiChunqiu-YinLv","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv"],"exceptions":[],"assertionLayer":"source-assertion","evidence":{"sourceId":"music:source:lushi_yinlv","normalization":"HTMLParser data joined by spaces; consecutive whitespace collapsed","normalizedTextChars":[6579,6830],"quote":"黃鐘生林鐘，林鐘生太蔟，太蔟生南呂，南呂生姑洗，姑洗生應鐘，應鐘生蕤賓，蕤賓生大呂，大呂生夷則，夷則生夾鐘，夾鐘生無射，無射生仲呂。三分所生，益之一分以上生；三分所生，去其一分以下生。黃鐘、（太）〔大〕呂、太蔟、夾鐘、姑洗、仲呂、蕤賓為上，林鐘、夷則、南呂、無射、應鐘為下。 大聖至理之世，天地之氣，合而生風，日至則月鐘其風，以生十二律。仲冬日短至，則生黃鐘。季冬生大呂。孟春生太蔟。仲春生夾鐘。季春生姑洗。孟夏生仲呂。仲夏日長至，則生蕤賓。季夏生林鐘。孟秋生夷則。仲秋生南呂。季秋生無射。孟冬生應鐘。","quoteSha256":"0edd5d065666a9e83eacb0eb635f184aee3f7864022c7edd76006721f9e8fe80"}},{"id":"music:chinese:lushi:pipe:0","nativeName":"黃鐘","aliases":[],"unit":"witness-named-lu-standard","tradition":"Chinese","witnessId":"LuShiChunqiu-YinLv","position":{"generation":null,"sequence":0,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv"],"exceptions":[],"assertionLayer":"source-assertion","evidence":{"sourceId":"music:source:lushi_yinlv","normalization":"HTMLParser data joined by spaces; consecutive whitespace collapsed","normalizedTextChars":[6579,6830],"quote":"黃鐘生林鐘，林鐘生太蔟，太蔟生南呂，南呂生姑洗，姑洗生應鐘，應鐘生蕤賓，蕤賓生大呂，大呂生夷則，夷則生夾鐘，夾鐘生無射，無射生仲呂。三分所生，益之一分以上生；三分所生，去其一分以下生。黃鐘、（太）〔大〕呂、太蔟、夾鐘、姑洗、仲呂、蕤賓為上，林鐘、夷則、南呂、無射、應鐘為下。 大聖至理之世，天地之氣，合而生風，日至則月鐘其風，以生十二律。仲冬日短至，則生黃鐘。季冬生大呂。孟春生太蔟。仲春生夾鐘。季春生姑洗。孟夏生仲呂。仲夏日長至，則生蕤賓。季夏生林鐘。孟秋生夷則。仲秋生南呂。季秋生無射。孟冬生應鐘。","quoteSha256":"0edd5d065666a9e83eacb0eb635f184aee3f7864022c7edd76006721f9e8fe80"},"nativeCoordinates":{"generationOrderIndex":0,"seasonalOrderIndex":0},"exactFrequency":null},{"id":"music:chinese:lushi:pipe:1","nativeName":"林鐘","aliases":[],"unit":"witness-named-lu-standard","tradition":"Chinese","witnessId":"LuShiChunqiu-YinLv","position":{"generation":null,"sequence":1,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv"],"exceptions":[],"assertionLayer":"source-assertion","evidence":{"sourceId":"music:source:lushi_yinlv","normalization":"HTMLParser data joined by spaces; consecutive whitespace collapsed","normalizedTextChars":[6579,6830],"quote":"黃鐘生林鐘，林鐘生太蔟，太蔟生南呂，南呂生姑洗，姑洗生應鐘，應鐘生蕤賓，蕤賓生大呂，大呂生夷則，夷則生夾鐘，夾鐘生無射，無射生仲呂。三分所生，益之一分以上生；三分所生，去其一分以下生。黃鐘、（太）〔大〕呂、太蔟、夾鐘、姑洗、仲呂、蕤賓為上，林鐘、夷則、南呂、無射、應鐘為下。 大聖至理之世，天地之氣，合而生風，日至則月鐘其風，以生十二律。仲冬日短至，則生黃鐘。季冬生大呂。孟春生太蔟。仲春生夾鐘。季春生姑洗。孟夏生仲呂。仲夏日長至，則生蕤賓。季夏生林鐘。孟秋生夷則。仲秋生南呂。季秋生無射。孟冬生應鐘。","quoteSha256":"0edd5d065666a9e83eacb0eb635f184aee3f7864022c7edd76006721f9e8fe80"},"nativeCoordinates":{"generationOrderIndex":1,"seasonalOrderIndex":7},"exactFrequency":null},{"id":"music:c