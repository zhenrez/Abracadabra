us","witnessId":"Irenaeus-I.4-I.5-NewAdvent","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["angelic:irenaeus_i_4_response","angelic:irenaeus_i_5"],"exceptions":["Source-role record scoped to I.4–5; matching names across recensions are not silently identified.","I.4calls upperSophia herfather inname-etiology and hermother/firstSophia later. Preserve both textual role expressions without forcing a biological-sex model.","Do not collapse upperSophia andAchamoth solely because the latter is also calledSophia."],"assertionLayer":"source-assertion"},{"id":"i45:Demiurge","nativeName":"Demiurge","aliases":["Metropator","Apator","Father","Hebdomas"],"unit":"source-named-creator","tradition":"Valentinian reported by Irenaeus","witnessId":"Irenaeus-I.4-I.5-NewAdvent","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["angelic:irenaeus_i_5"],"exceptions":["Source-role record scoped to I.4–5; matching names across recensions are not silently identified.","Source both describes him above the seven heavens and as dwelling in the heavenly/hebdomad place; no single numeric coordinate is imposed."],"assertionLayer":"source-assertion"},{"id":"i45:Cosmocrator","nativeName":"Cosmocrator","aliases":["devil (this source account)"],"unit":"source-named-world-ruler","tradition":"Valentinian reported by Irenaeus","witnessId":"Irenaeus-I.4-I.5-NewAdvent","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["angelic:irenaeus_i_5"],"exceptions":["Source-role record scoped to I.4–5; matching names across recensions are not silently identified."],"assertionLayer":"source-assertion"},{"id":"i45:created-angels","nativeName":"Angels created by the Demiurge","aliases":[],"unit":"source-reported-angelic-collective","tradition":"Valentinian reported by Irenaeus","witnessId":"Irenaeus-I.4-I.5-NewAdvent","position":{"generation":null,"sequence":