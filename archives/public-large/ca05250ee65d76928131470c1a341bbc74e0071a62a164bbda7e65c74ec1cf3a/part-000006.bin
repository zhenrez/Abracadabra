60"],"lengthMultiplierExact":"4/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":10519,"endCodePointExclusive":10577,"text":"應鐘，九萬三千三百一十二。上生蕤賓。應鐘為宮，大呂商，蕤賓徵。 一日律，四寸七分小分四微強。準，四尺七寸八千十九。 "}},{"id":"chinese-expanded:relation:554","source":"chinese-expanded:houhan:standard:分烏","target":"chinese-expanded:houhan:standard:南事","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"4/3","sourceIntegerResidual":"-2","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":10577,"endCodePointExclusive":10635,"text":"分烏，九萬三千一百一十七。上生南事。分烏窮次，無徵，不為宮。 七日律，四寸七分小分三微強。準，四尺七寸六千五十九。 "}},{"id":"chinese-expanded:relation:555","source":"chinese-expanded:houhan:standard:遲內","target":"chinese-expanded:houhan:standard:盛變","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"4/3","sourceIntegerResidual":"-1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":10635,"endCodePointExclusive":10694,"text":"遲內，九萬二千五十六。上生盛變。遲內為宮，分否商，盛變徵。 八日律，四寸六分小分八弱。準，四尺六寸萬五千一百四十二。 "}},{"id":"chinese-expanded:relation:556","source":"chinese-expanded:houhan:standard:未育","target":"chinese-expanded:houhan:standard:離宮","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"4/3","sourceIntegerResidual":"2189/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","st