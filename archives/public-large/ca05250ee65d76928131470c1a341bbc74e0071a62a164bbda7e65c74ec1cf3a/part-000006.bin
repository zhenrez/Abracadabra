nese-expanded:houhan:root","target":"chinese-expanded:houhan:standard:應鐘","type":"has-witness-lu-standard","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"]},{"id":"chinese-expanded:relation:495","source":"chinese-expanded:houhan:root","target":"chinese-expanded:houhan:standard:分烏","type":"has-witness-lu-standard","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"]},{"id":"chinese-expanded:relation:496","source":"chinese-expanded:houhan:root","target":"chinese-expanded:houhan:standard:遲內","type":"has-witness-lu-standard","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"]},{"id":"chinese-expanded:relation:497","source":"chinese-expanded:houhan:root","target":"chinese-expanded:houhan:standard:未育","type":"has-witness-lu-standard","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"]},{"id":"chinese-expanded:relation:498","source":"chinese-expanded:houhan:root","target":"chinese-expanded:houhan:standard:遲時","type":"has-witness-lu-standard","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"]},{"id":"chinese-expanded:relation:499","source":"chinese-expanded:houhan:standard:黃鐘","target":"chinese-expanded:houhan:standard:林鐘","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7248,"endCodePointExclusive":7292,"text":"黃鐘，十七萬七千一百四十七。下生林鐘。黃鐘為宮，太蔟商，林鐘徵。 一日律九寸，準九尺。 "}},{"id":"chinese-expanded:relation:500","source":"chinese-expanded:houhan:standard:色育","target":"chinese-expanded:houhan:standard:謙待","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7292,"endCodePointExclusive":7355,"text":"色育，十七萬六千七百七十六。下生謙待。色育為宮，未知商，謙待徵。 六日律，八寸九分小分八微強。準，八尺九寸萬五千九百七十三。 "}},{"id":"chinese-expanded:relation:501","source":"chinese-expanded:houhan:standard:執始","target":"chinese-expanded:houhan:standard:去滅","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7355,"endCodePointExclusive":7418,"text":"執始，十七萬四千七百六十二。下生去滅。執始為宮，時息商，去滅徵。 六日律，八寸八分小分七大強。準，八尺八寸萬五千五百一十六。 "}},{"id":"chinese-expanded:relation:502","source":"chinese-expanded:houhan:standard:丙盛","target":"chinese-expanded:houhan:standard:安度","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7418,"endCodePointExclusive":7480,"text":"丙盛，十七萬二千四百一十。下生安度。丙盛為宮，屈齊商，安度徵。 六日律，八寸七分小分六微弱。準，八尺七寸萬一千六百七十九。 "}},{"id":"chinese-expanded:relation:503","source":"chinese-expanded:houhan:standard:分動","target":"chinese-expanded:houhan:standard:歸嘉","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7480,"endCodePointExclusive":7537,"text":"分動，十七萬八十九。下生歸嘉。分動為宮，隨期商，歸嘉徵。 六日律，八寸六分小分四強。準，八尺六寸八千一百五十二。 "}},{"id":"chinese-expanded:relation:504","source":"chinese-expanded:houhan:standard:質末","target":"chinese-expanded:houhan:standard:否與","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7537,"endCodePointExclusive":7595,"text":"質末，十六萬七千八百。下生否與。質末為宮，形晉商，否與徵。 六日律，八寸五分小分二強。準，八尺五寸四千九百四十五。 "}},{"id":"chinese-expanded:relation:505","source":"chinese-expanded:houhan:standard:大呂","target":"chinese-expanded:houhan:standard:夷則","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7595,"endCodePointExclusive":7654,"text":"大呂，十六萬五千八百八十八。下生夷則。大呂為宮，夾鐘商，夷則徵。 八日律，八寸四分小分三弱。準，八尺四寸五千五百八。 "}},{"id":"chinese-expanded:relation:506","source":"chinese-expanded:houhan:standard:分否","target":"chinese-expanded:houhan:standard:解形","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"30001/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7654,"endCodePointExclusive":7715,"text":"分否，十六萬三千六百五十四。下生解形。分否為宮，開時商，解形徵。 八日律，八寸三分小分一強。準，八尺三寸二千八百五十一。 "}},{"id":"chinese-expanded:relation:507","source":"chinese-expanded:houhan:standard:凌陰","target":"chinese-expanded:houhan:standard:去南","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7715,"endCodePointExclusive":7774,"text":"凌陰，十六萬一千四百五十二。下生去南。凌陰為宮，族嘉商，去南徵。 八日律，八寸二分小分一弱。準，八尺二寸五百一十四。 "}},{"id":"chinese-expanded:relation:508","source":"chinese-expanded:houhan:standard:少出","target":"chinese-expanded:houhan:standard:分積","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"4/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7774,"endCodePointExclusive":7830,"text":"少出，十五萬九千二百八十。下生分積。少出為宮，爭南商，分積徵。 六日律，八寸小分九強。準，八尺萬八千一百六十。 "}},{"id":"chinese-expanded:relation:509","source":"chinese-expanded:houhan:standard:太蔟","target":"chinese-expanded:houhan:standard:南呂","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7830,"endCodePointExclusive":7876,"text":"太蔟，十五萬七千四百六十四。下生南呂。太蔟為宮，姑洗商，南呂徵。 一日律，八寸。準，八尺。 "}},{"id":"chinese-expanded:relation:510","source":"chinese-expanded:houhan:standard:未知","target":"chinese-expanded:houhan:standard:白呂","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"0","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7876,"endCodePointExclusive":7938,"text":"未知，十五萬七千一百三十四。下生白呂。未知為宮，南授商，白呂徵。 六日律，七寸九分小分八強。準，七尺九寸萬六千三百八十三。 "}},{"id":"chinese-expanded:relation:511","source":"chinese-expanded:houhan:standard:時息","target":"chinese-expanded:houhan:standard:結躬","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":7938,"endCodePointExclusive":8001,"text":"時息，十五萬五千三百四十四。下生結躬。時息為宮，變虞商，結躬徵。 六日律，七寸八分小分九少強。準，七尺八寸萬八千一百六十六。 "}},{"id":"chinese-expanded:relation:512","source":"chinese-expanded:houhan:standard:屈齊","target":"chinese-expanded:houhan:standard:歸期","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60"],"lengthMultiplierExact":"2/3","sourceIntegerResidual":"1/3","evidence":{"sourceId":"chinese-expanded:houhan91","normalizedTextPath":"state/research/chinese-expanded/houhan91.normalized.txt","startCodePoint":8001,"endCodePointExclusive":8063,"text":"屈齊，十五萬三千二百五十三。下生歸期。屈齊為宮，路時商，歸期徵。 六日律，七寸七分小分九弱。準，七尺七寸萬六千九百三十九。 "}},{"id":"chinese-expanded:relation:513","source":"chinese-expanded:houhan:standard:隨期","target":"chinese-expanded:houhan:standard:未卯","type":"source-generates-next-lu","sourceRefs":["chinese-expanded:houhan91"],"assertionLayer":"source-assertion","viewIds":["chinese-expanded:jingfang60