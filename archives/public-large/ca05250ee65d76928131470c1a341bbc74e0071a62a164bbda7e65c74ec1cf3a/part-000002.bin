iao 為調之調. [4.2] Historically, pentatonic modes have been represented both as ( pc pent , pos final ) or ( pc final , pos final ). (18) Consider these two modes: for D, E, G, A, C, the pc pent is C, the pc final is D, and the pos final is shang , for C, "}},{"id":"chinese-expanded:lam:mode-tone:8:1:0","nativeName":"商 in mode(8,1)","aliases":[],"unit":"mode-qualified-tone-membership-occurrence","tradition":"Chinese","witnessId":"Lam2024","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lam2024"],"assertionLayer":"source-rule-derived","exceptions":["Five memberships per source-defined mode; repeated pitch identities across modes are not new physical notes."],"abstractPitchClass":10,"nativeTonePosition":1,"modeRelativePosition":0,"physicalFrequencyHz":null,"absoluteRegister":null},{"id":"chinese-expanded:lam:mode-tone:8:1:1","nativeName":"角 in mode(8,1)","aliases":[],"unit":"mode-qualified-tone-membership-occurrence","tradition":"Chinese","witnessId":"Lam2024","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lam2024"],"assertionLayer":"source-rule-derived","exceptions":["Five memberships per source-defined mode; repeated pitch identities across modes are not new physical notes."],"abstractPitchClass":0,"nativeTonePosition":2,"modeRelativePosition":1,"physicalFrequencyHz":null,"absoluteRegister":null},{"id":"chinese-expanded:lam:mode-tone:8:1:2","nativeName":"徵 in mode(8,1)","aliases":[],"unit":"mode-qualified-tone-membership-occurrence","tradition":"Chinese","witnessId":"Lam2024","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lam2024"],"assertionLayer":"source-rule-derived","exceptions":["Five memberships per source-defined mode; repeated pitch identities across modes are not new physical notes."],"abstractPitchClass":3,"nativeTonePosition":3,"modeRelativePosition"