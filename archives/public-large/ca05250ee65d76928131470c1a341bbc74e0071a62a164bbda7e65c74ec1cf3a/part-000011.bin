calibration","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["03f0379cbb66614ceb1b95a29c315a164127f7daeb598e8be317ebf85fe75d10"],"exceptions":["Recovered source-locked research calibration, not a fresh ancient-source adjudication or identity with a sefirah."],"assertionLayer":"editorial"},{"id":"music:chinese:root","nativeName":"Chinese native structures — distinct source witnesses","aliases":[],"unit":"source-scoped-musical-family","tradition":"Chinese","witnessId":"Chinese-witness-collection","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv","music:source:zhouli_zhushu23","music:source:lam2024"],"exceptions":[],"assertionLayer":"source-assertion"},{"id":"music:chinese:lushi","nativeName":"呂氏春秋 音律 witness","aliases":[],"unit":"native-text-musical-system","tradition":"Chinese","witnessId":"LuShiChunqiu-YinLv","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv"],"exceptions":[],"assertionLayer":"source-assertion","evidence":{"sourceId":"music:source:lushi_yinlv","normalization":"HTMLParser data joined by spaces; consecutive whitespace collapsed","normalizedTextChars":[6579,6830],"quote":"黃鐘生林鐘，林鐘生太蔟，太蔟生南呂，南呂生姑洗，姑洗生應鐘，應鐘生蕤賓，蕤賓生大呂，大呂生夷則，夷則生夾鐘，夾鐘生無射，無射生仲呂。三分所生，益之一分以上生；三分所生，去其一分以下生。黃鐘、（太）〔大〕呂、太蔟、夾鐘、姑洗、仲呂、蕤賓為上，林鐘、夷則、南呂、無射、應鐘為下。 大聖至理之世，天地之氣，合而生風，日至則月鐘其風，以生十二律。仲冬日短至，則生黃鐘。季冬生大呂。孟春生太蔟。仲春生夾鐘。季春生姑洗。孟夏生仲呂。仲夏日長至，則生蕤賓。季夏生林鐘。孟秋生夷則。仲秋生南呂。季秋生無射。孟冬生應鐘。","quoteSha256":"0edd5d065666a9e83eacb0eb635f184aee3f7864022c7edd76006721f9e8fe80"}},{"id":"music:chinese:lushi:pipe:0","nativeName":"黃鐘","aliases":[],"unit":"witness-named-lu-standard","tradition":"Chinese","witnessId":"LuShiChunqiu-YinLv","position":{"generation":null,"sequence":0,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["music:source:lushi_yinlv"],"exceptions":[],"assertionLayer":"source-assertion","eviden