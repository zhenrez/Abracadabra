r Sign up for emails about special offers, discounts, latest news, and more. Go Please enter a valid email. Friends of HKCO Download Application Form Contact Us Copyright © 2026 HKCO View Mobile Version //Google Analytic (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){ (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o), m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m) })(window,document,'script','https://www.google-analytics.com/analytics.js','ga'); ga('create', 'UA-76405764-1', 'auto'); ga('send', 'pageview');\n"},"completeHistoricalInstrumentInventory":false,"individualPlayerCount":null,"physicalInstrumentCount":null},{"id":"chinese-expanded:hkco:family:percussion","nativeName":"percussion","aliases":[],"unit":"HKCO-playing-technique-family","tradition":"Chinese","witnessId":"HKCO2025-2026","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["chinese-expanded:hkco-percussion"],"assertionLayer":"source-assertion","exceptions":[],"evidence":{"sourceId":"chinese-expanded:hkco-percussion","normalizedTextPath":"state/research/chinese-expanded/hkco-percussion.normalized.txt","startCodePoint":4191,"endCodePointExclusive":5691,"text":"The Hong Kong Chinese Orchestra's percussion section is primarily made up of two sets: Chinese traditional percussion instruments and Western percussion instruments (both with pitched and un-pitched categories). Chinese traditional percussion instruments comprise the metal type (large gongs, small gongs, cloud gongs, cymbals, bells and chimes etc.), the wood type (clappers, bamboo clappers, bangzi and temple block etc.) and the skin type (dagu, paigu, hand drums etc.). The other set comprises Western percussion instruments such as timpani, xylophone, chimes, glockenspiel, vibraphone, bass drum, snare drum and cymbals, etc.. The following is a list of some percussion instruments. Contact Us Copyright © 2026 HKCO View Desktop Version Your Support The HKCO is a non-profit organization. It is through your support that we can continue to make life beautiful, with arts, music, and a thankful heart. Sponsorship & Donation Advertisement Subscribe Newsletter Sign up for emails about special offers, discounts, latest news, and more. Go Please enter a valid email. Friends of HKCO Download Application Form Contact Us Copyright © 2026 HKCO View Mobile Version //Google Analytic (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){ (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o), m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m) })(window,document,'script','https://www.google-analytics.com/analytics.js','ga')"}},{"id":"chinese-expanded:hkco:instrument:percussion:standard:0","nativeName":"large gongs","aliases":[],"unit":"first-party-instrument-name-occurrence","tradition":"Chinese","witnessId":"HKCO2025-2026","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["chinese-expanded:hkco-percussion"],"assertionLayer":"source-assertion","exceptions":["Witness-named kind/reference, not a physical player or complete tradition-wide inventory; percussion bilingual labels can overlap."],"sourceMembership":"standard","evidence":{"sourceId":"chinese-expanded:hkco-percussion","normalizedTextPath":"state/research/chinese-expanded/hkco-percussion.normalized.txt","startCodePoint":4191,"endCodePointExclusive":5691,"text":"The Hong Kong Chinese Orchestra's percussion section is primarily made up of two sets: Chinese traditional percussion instruments and Western percussion instruments (both with pitched and un-pitched categories). Chinese traditional percussion instruments comprise the metal type (large gongs, small gongs, cloud gongs, cymbals, bells and chimes etc.), the wood type (clappers, bamboo clappers, bangzi and temple block etc.) and the skin type (dagu, paigu, hand drums etc.). The other set comprises Western percussion instruments such as timpani, xylophone, chimes, glockenspiel, vibraphone, bass drum, snare drum and cymbals, etc.. The following is a list of some percussion instruments. Contact Us Copyright © 2026 HKCO View Desktop Version Your Support The HKCO is a non-profit organization. It is through your support that we can continue to make life beautiful, with arts, music, and a thankful heart. Sponsorship & Donation Advertisement Subscribe Newsletter Sign up for emails about special offers, discounts, latest news, and more. Go Please enter a valid email. Friends of HKCO Download Application Form Contact Us Copyright © 2026 HKCO View Mobile Version //Google Analytic (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){ (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o), m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m) })(window,document,'script','https://www.google-analytics.com/analytics.js','ga')"},"completeHistoricalInstrumentInventory":false,"individualPlayerCount":null,"physicalInstrumentCount":null},{"id":"chinese-expanded:hkco:instrument:percussion:standard:1","nativeName":"small gongs","aliases":[],"unit":"first-party-instrument-name-occurrence","tradition":"Chinese","witnessId":"HKCO2025-2026","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["chinese-expanded:hkco-percussion"],"assertionLayer":"source-assertion","exceptions":["Witness-named kind/reference, not a physical player or complete tradition-wide inventory; percussion bilingual labels can overlap."],"sourceMembership":"standard","evidence":{"sourceId":"chinese-expanded:hkco-percussion","normalizedTextPath":"state/research/chinese-expanded/hkco-percussion.normalized.txt","startCodePoint":4191,"endCodePointExclusive":5691,"text":"The Hong Kong Chinese Orchestra's percussion section is primarily made up of two sets: Chinese traditional percussion instruments and Western percussion instruments (both with pitched and un-pitched categories). Chinese traditional percussion instruments comprise the metal type (large gongs, small gongs, cloud gongs, cymbals, bells and chimes etc.), the wood type (clappers, bamboo clappers, bangzi and temple block etc.) and the skin type (dagu, paigu, hand drums etc.). The other set comprises Western percussion instruments such as timpani, xylophone, chimes, glockenspiel, vibraphone, bass drum, snare drum and cymbals, etc.. The following is a list of some percussion instruments. Contact Us Copyright © 2026 HKCO View Desktop Version Your Support The HKCO is a non-profit organization. It is through your support that we can continue to make life beautiful, with arts, music, and a thankful heart. Sponsorship & Donation Advertisement Subscribe Newsletter Sign up for emails about special offers, discounts, latest news, and more. Go Please enter a valid email. Friends of HKCO Download Application Form Contact Us Copyright © 2026 HKCO View Mobile Version //Google Analytic (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){ (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o), m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m) })(window,document,'script','https://www.google-analytics.com/analytics.js','ga')"},"completeHistoricalInstrumentInventory":false,"individualPlayerCount":null,"physicalInstrumentCount":null},{"id":"chinese-expanded:hkco:instrument:percussion:standard:2","nativeName":"cloud gongs","aliases":[],"unit":"first-party-instrument-name-occurrence","tradition":"Chinese","witnessId":"HKCO2025-2026","position":{"generation":null,"sequence":null,"cyclicCoordinate":null,"orientation":null},"sourceRefs":["chinese-expanded:hkco-percussion"],"assertionLayer":"source-assertion","exceptions":["Witness-named kind/reference, not a physical player or complete tradition-wide inve