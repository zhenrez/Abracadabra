rinted233footnote25","primaryCollationPending":true},"conditionalExecutions":[{"reading":{"editionReport":"Yuditsky / Carrera Companioni2022p190 as cited by Howard","theme":"ο"},"transcriptionGrades":["O-grade","O-grade","O-grade","A-grade","A-grade","A-grade"],"checkedContexts":6,"simpleSuffixConditionConflicts":[],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"},{"reading":{"editionReport":"Sperber1938p159 as cited by Howard","theme":"α"},"transcriptionGrades":["O-grade","O-grade","A-grade","A-grade","A-grade","A-grade"],"checkedContexts":6,"simpleSuffixConditionConflicts":["Ps18:36"],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"},{"reading":{"editionReport":"Mercati unread theme vowel as reported by Howard","theme":null},"transcriptionGrades":["O-grade","O-grade",null,"A-grade","A-grade","A-grade"],"checkedContexts":5,"simpleSuffixConditionConflicts":[],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"}],"retainedExplanations":[{"id":"syllable_conditioned_rounding","source":"Howard2026pp232–237","status":"source-proposed; conditional"},{"id":"morphological_stem_or_analogy","source":"Alternative scholarship discussed by Howardpp231–233","status":"retained competing explanation; not eliminated by the same grade pattern"}],"provisionalComparisonArguments":["source-qualified sign","historical vowel class","syllable environment","morphology","stress/pause","tradition and source date","edition reading"],"typeBoundary":"These arguments are required by this source comparison; they are not asserted complete or irreducible universal types.","chronology":{"source":"Howardp235 critiques transfer of a local assimilation date to the broader shift; Kantor2023pp78–79 retains the earlier argument.","events":["L_local_pre_waw_rounding","V_w_to_v","G_general_syllable_shift"],"conditionalPrecedenceEdges":[["L_local_pre_waw_rounding","V_w_to_v"],["L_local_pre_waw_rounding","G_general_syllable_shift"]],"allStrictLinearExtensions":[["L_local_pre_waw_rounding","V_w_to_v","G_general_syllable_shift"],["L_local_pre_waw_rounding","G_general_syllable_shift","V_w_to_v"]],"newConsequence":"L<V and L<G do not entail G<V. An upper bound on V does not supply an upper bound on G without an additional bridge premise.","proof":"Both listed total orders satisfy every supplied edge, but they place G on opposite sides of V. One is a countermodel to each purported forced order.","missingPremise":"An independently justified relation between local assimilation and the broader shift sufficient to transfer the claimed date bound.","scope":"Conditional relative chronology of phonological processes; no ancient calendar date or institutional rectification selected"},"coarseFeatureBoundary":"The old five-tradition binary example remains preserved within its assumptions. Contextual/lexical diffusion and disputed forms require explicit refinement before transferring its topology counts to historical genealogy.","independence":"Howard reassesses earlier editions and arguments; this is not an independent newly discovered manuscript. Six published forms are not six independent historical witnesses.","open":["Independent collation of Ps18:36 theme vowel","Original chronology/contact witnesses","Licensing Greek transcription grade to a historical phone","Discrimination of phonological and morphological explanations"],"originalSoundRecovered":false,"historicalGenealogySelected":false,"blindPrediction":false,"fullMissionComplete":false,"inputSnapshots":[{"sourcePath":"state/delivery-2026-11-07/symbol-contact/root/howard-2026-qames.pdf","snapshotPath":"data/raw/reconstruction-integrations/a7d1fe74dd7025bf31fbbcaf704104df1b796e5728d4c326172507ba150c0335/howard-2026-qames.pdf","sha256":"a7d1fe74dd7025bf31fbbcaf704104df1b796e5728d4c326172507ba150c0335","bytes":657366},{"sourcePath":"state/delivery-2026-11-07/symbol-contact/root/howard-pages.json","snapshotPath":"data/raw/reconstruction-integrations/8703444e47873513a965426be09efb636205eb19a2bac96b7984432ed845cfb3/howard-pages.json","sha256":"8703444e47873513a965426be09efb636205eb19a2bac96b7984432ed845cfb3","bytes":46786},{"sourcePath":"state/jev-receipts/000060-a1b30f75db7d.json","snapshotPath":"data/raw/reconstruction-integrations/1ecf36869c3bbee45cf23c877d70b27bf9a102e53e667d06ec58d6f25b44fbf9/000060-a1b30f75db7d.json","sha256":"1ecf36869c3bbee45cf23c877d70b27bf9a102e53e667d06ec58d6f25b44fbf9","bytes":5513}],"codeBindings":[{"path":"scripts/derive_phonological_context.py","sha256":"2197ccd062f80db06ca6ce9ca621ed54afbb9ff9954d9e9e646bca2e8b91bf5b"},{"path":"tests/phonological_context_independent.py","sha256":"ba4c1f93c8259dca5462721426c6e506fa30b5feefc96ae2521f8f71536cdbda"}]},"phonological-history-constraints":{"schema":"sunny.phonological-history-constraints.v1","jevReceipt":"state/jev-receipts/000061-54b57b45fbcd.json","problem":"Derive which source-qualified constraints can discriminate inheritance, contact, parallel change and observation-channel explanations.","nativeConditions":["Same lexical item or justified correspondence, historical vowel, morphology, syllable environment, performance register and feature identity are required before joining observations.","Distinct community-specific events remain distinct: the reported T v and B w do not license a common consonantal-change event.","Innovation onset, earliest surviving positive attestation, copy date and first community acquisition are distinct addresses.","A dated positive attestation gives an onset upper bound under persistence; it does not date the innovation exactly or supply its lower bound.","Monotonicity/no loss and direct feature-causing contact are explicit model conditions, not universal historical rules."],"sourceCases":{"coarseFeature":{"id":"PW-C1","sourceLocator":"Chapter4 §2.1.1, pp77-79, Table9 on printed77/PDF90","sourceClaimStatus":"Author's proposed innovation and supporting argument inspected; underlying manuscript and external chronology claims not independently reproduced","feature":"Rounding/raising of historically long a into the rounded qameṣ vowel","proposedEarlierState":"*/aː/","proposedDerivedState":"*/ɔː/","authorReportedDerivedTraditions":["Tiberian","Babylonian"],"authorReportedUnroundedComparanda":["Secunda","Jerome","Palestinian"],"table9ExampleAddresses":{"Babylonian":"1Sam14:32","Tiberian":"Exod18:17","Secunda":"Ps18:28","Jerome":"Gen2:23","Palestinian":"Ps37:28"},"qualification":"These are contextual examples of a reconstructed feature, not the same lexical token across all traditions. The author discusses ambiguous transcription and change chronology before proposing a shared innovation.","missingIndependentPremises":["Original witness collation behind cited editions","Transcription-to-phone licensing","The external relative/absolute chronology argument"],"sunnyUse":"A feature record can carry the proposed change, its environment, date constraints, counterexamples and uncertainty. The written vowel does not prescribe an acoustic frequency or musical pitch."},"copyingAlternative":{"id":"PW-C3","sourceLocator":"Chapter5 §2.3, pp178-179, Table66 on p178","sourceClaimStatus":"Same-reading manuscript contrast and author's interpretation inspected; manuscript-by-manuscript collation remains external","feature":"Changes in medieval Secunda spellings toward Tiberian/standard conventions","concreteLocality":"Ps49:6 as numbered in the source table: short-o transcription is changed toward u; other listed changes include epenthesis and vowel substitutions","observationLevel":"Manuscript transcription/spelling variants; proposed corresponding sounds are the author's interpretation","relationTypeForInvestigation":"scribal_normalization_toward_standard","sunnyUse":"A copying/standardization edge can explain a shared form without creating a new ancestry edge or asserting that a community changed its living pronunciation.","boundary":"Table66 contrasts best/other manuscript groups and refers to a critical edition; this task has not recovered every manuscript identifier or recollated the physical ink."},"contextualReadingBranches":[{"reading":{"editionReport":"Yuditsky / Carrera Companioni2022p190 as cited by Howard","theme":"ο"},"transcriptionGrades":["O-grade","O-grade","O-grade","A-grade","A-grade","A-grade"],"checkedContexts":6,"simpleSuffixConditionConflicts":[],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"},{"reading":{"editionReport":"Sperber1938p159 as cited by Howard","theme":"α"},"transcriptionGrades":["O-grade","O-grade","A-grade","A-grade","A-grade","A-grade"],"checkedContexts":6,"simpleSuffixConditionConflicts":["Ps18:36"],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"},{"reading":{"editionReport":"Mercati unread theme vowel as reported by Howard","theme":null},"transcriptionGrades":["O-grade","O-grade",null,"A-grade","A-grade","A-grade"],"checkedContexts":5,"simpleSuffixConditionConflicts":[],"scope":"Compatibility of this explicit transcription-grade rule only; no broad phonological or morphological account eliminated"}],"sourceGradeIsNotPhone":true,"refinement":"The older105/15treecount experiment remains intact within its declared binary character and no-contact assumptions. It does not adjudicate the richer contexts or networks."},"operator":{"implementation":"src/phonological-history.ts","domain":"Three real-valued event windows with exact rational or unbounded endpoints; endpoint inclusion retained.","relation":"donorOnset < contact <= recipientOnset; weak-donor equality is an explicit alternative parameter.","projection":"admissibleContact = K intersect (inf(D), sup(R)), with the recipient upper endpoint included exactly when R includes it; all input windows must be nonempty.","proof":"A feasible contact must exceed the donor infimum and not exceed an available recipient supremum. Conversely choose any point in that intersection, choose an earlier donor in D, and a recipient at or after it in R. Strict/open endpoints determine equality cases. The weak-donor case admits the donor lower endpoint only if D contains it.","exactWitnessReturned":true,"inputEndpointIntegerDigitBudget":128,"derivedRationalDigitsUnbounded":true,"resourceBoundary":"The endpoint input budget is computational only; it does not choose a historical time scale."},"conditionalControls":[{"id":"positive_attestations_B_then_T","inputs":[{"lower":null,"upper":{"numerator":"6","denominator":"1"},"lowerClosed":true,"upperClosed":true},{"lower":null,"upper":null,"lowerClosed":true,"upperClosed":true},{"lower":null,"upper":{"numerator":"9","denominator":"1"},"lowerClosed":true,"upperClosed":true}],"expected":true,"proper":[],"result":{"feasible":true,"admissibleContact":{"lower":null,"upper":{"numerator":"9","denominator":"1"},"lowerClosed":false,"upperClosed":true},"witness":{"donorOnset":{"numerator":"5","denominator":"1"},"contact":{"numerator":"8","denominator":"1"},"recipientOnset":{"numerator":"17","denominator":"2"}},"reason":"A real-valued timing assignment exists within the declared intervals; historical transmission is not established."},"scope":"Synthetic arbitrary order coordinates, not attested dates or extracted historical bounds"},{"id":"same_attestations_reverse_direction","inputs":[{"lower":null,"upper":{"numerator":"9","denominator":"1"},"lowerClosed":true,"upperClosed":true},{"lower":null,"upper":null,"lowerClosed":true,"upperClosed":true},{"lower":null,"upper":{"numerator":"6","denominator":"1"},"lowerClosed":true,"upperClosed":true}],"expected":true,"proper":[],"result":{"feasible":true,"admissibleContact":{"lower":null,"upper":{"numerator":"6","denominator":"1"},"lowerClosed":false,"upperC