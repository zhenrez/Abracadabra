me up from the Babylonian exile with Zerubbabel, that was unable to give its ancestral genealogy. (Ezr. 2:60, Neh. 7:62) Son of Mehetabel and father of Shemaiah. (Neh. 6:10) He is probably identical to the previous entry.)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:delaiah_1002","nativeName":"Delaiah","name":"Delaiah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"delaiah_1002","sourceRecordOrdinalOneBased":680,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Ezra.2.60","Neh.7.62"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Delaiah (The descendants of Delaiah)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:delaiah_1003","nativeName":"Delaiah","name":"Delaiah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"delaiah_1003","sourceRecordOrdinalOneBased":681,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Neh.6.10"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Delaiah (son of Mehetabel)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:delaiah_1004","nativeName":"Delaiah","name":"Delaiah","aliases":[],"unit":"Curated Biblical named-entity/person record"