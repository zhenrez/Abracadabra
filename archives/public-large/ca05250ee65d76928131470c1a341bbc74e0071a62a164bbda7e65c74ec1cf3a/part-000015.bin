tionNote":"","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:kohath_1790","nativeName":"Kohath","name":"Kohath","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"kohath_1790","sourceRecordOrdinalOneBased":1776,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Gen.46.11","Exod.6.16","Exod.6.18","Num.3.17","Num.3.19","Num.3.27","Num.3.29","Num.4.2","Num.4.4","Num.4.15","Num.7.9","Num.16.1","Num.26.57","Num.26.58","Josh.21.5","Josh.21.20","Josh.21.26","1Chr.6.1","1Chr.6.2","1Chr.6.16","1Chr.6.18","1Chr.6.22","1Chr.6.38","1Chr.6.61","1Chr.6.66","1Chr.6.70","1Chr.15.5","1Chr.23.6","1Chr.23.12"],"genderAsCurated":"Male","ambiguousAsCurated":false,"disambiguationNote":"","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:kolaiah_1791","nativeName":"Kolaiah","name":"Kolaiah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"kolaiah_1791","sourceRecordOrdinalOneBased":1777,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Neh.11.7"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Kolaiah (the son of Maaseiah)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:kolaiah_1792","nativeName":"Kolaiah","name":"Kolaiah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"kolaiah_1792","sourceRecordOrdinalOneBased":1778,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Jer.29.21"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Kolaiah (Voice of Jehovah)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:korah_1793","nativeName":"Korah","name":"Korah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"korah_1793","sourceRecordOrdinalOneBased":1779,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Gen.36.5","Gen.36.14","Gen.36.18","1Chr.1.35"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Korah (or Kórach (Hebrew: קֹרַח, Standard Qóraḥ Tiberian Qōraḥ; \"Baldness; ice; hail; frost\", Arabic: قارون Qārūn) is a name which is associated with at least two men in the Hebrew Bible. Some older English translations, as well as the Douay–Rheims Bible, spell the name Core,[1] and many Eastern European translations have Korak. According to the Book of Genesis 36:5, Korah was the son of Esau and Aholibamah, and had two brothers, Jeush and Jaalam. Genesis 36:14 has Korah's mother, Aholibamah, being daughter of Anah, and granddaughter of Zibeon, making Zibeon Korah's maternal great grandfather. The same verse repeats Genesis 36:5 and names his two brothers again. Anah in Genesis 36:2,14,18,25 mentioned above is the same as the Anah, the son of Zibeon in verse 24. In verse 2 and 14 it says, \"Aholibamah the daughter of Anah, the daughter of Zibeon the Hivite.\" Some are confused with this wording and believe that it is saying that Anah is a daughter of Zibeon. In verse 24 it clearly says that Zibeon's two sons were Ajah and Anah. Since the original text does not have a literal word for \"granddaughter\", the word bat (\"daughter\") was used in both cases. But this sentence is stating that Aholibamah is the daughter of Anah and the \"granddaughter\" of Zibeon, not that Anah is the daughter of Zibeon.)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:korah_1794","nativeName":"Korah","name":"Korah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"korah_1794","sourceRecordOrdinalOneBased":1780,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Gen.36.16"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Korah (son of Eliphaz)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:korah_1795","nativeName":"Korah (Levite)","name":"Korah","aliases":["Core"],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"korah_1795","sourceRecordOrdinalOneBased":1781,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["Exod.6.21","Exod.6.24","Num.16.1","Num.16.5","Num.16.6","Num.16.8","Num.16.16","Num.16.19","Num.16.24","Num.16.27","Num.16.32","Num.16.40","Num.16.49","Num.26.9","Num.26.10","Num.26.11","Num.27.3","1Chr.6.22","1Chr.6.37","1Chr.9.19","Ps.42.1","Ps.44.1","Ps.49.1","Ps.85.1","Ps.87.1","Jude.1.11"],"genderAsCurated":"Male","ambiguousAsCurated":false,"disambiguationNote":"Korah(sons of Izhar)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndepen