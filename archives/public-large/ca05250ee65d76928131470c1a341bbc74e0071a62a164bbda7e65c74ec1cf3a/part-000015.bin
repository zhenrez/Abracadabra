ah king of Israel. (2 Chronicles 28:7) (B.C. 738.)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:azrikam_565","nativeName":"Azrikam","name":"Azrikam","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"azrikam_565","sourceRecordOrdinalOneBased":414,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["1Chr.9.14","Neh.11.15"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Azrikam (father of Hasshub)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:azrikam_566","nativeName":"Azrikam","name":"Azrikam","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"azrikam_566","sourceRecordOrdinalOneBased":415,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["2Chr.28.7"],"genderAsCurated":"Male","ambiguousAsCurated":true,"disambiguationNote":"Azrikam (David his father)","generation":null,"absoluteChronology":null,"musicalAssignment":null,"historicalIndividualIndependentlyConfirmed":false,"curatedChronologyNotAdopted":{"birthYear":"","deathYear":"","basis":"Maintainer follows modern Jones chronology; not substituted for received witness clocks."}},{"id":"bible:theographic:azubah_567","nativeName":"Azubah","name":"Azubah","aliases":[],"unit":"Curated Biblical named-entity/person record","sourceRecordKey":"azubah_567","sourceRecordOrdinalOneBased":416,"sourceRefs":["theographic:CSV/People.csv"],"verseRefs":["1Kgs.22.42","2Chr.20.31"],"genderAsCurated":"Female","ambiguous