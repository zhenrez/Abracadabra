          "entities": [
            {
              "id": "i45:Achamoth",
              "nativeName": "Achamoth / Enthymesis of Sophia",
              "aliases": [
                "Sophia (after the upper Sophia)",
                "Holy Spirit",
                "Ogdoad",
                "Terra",
                "Jerusalem",
                "Lord (masculine reference)"
              ],
              "unit": "source-named-enthymesis",
              "tradition": "Valentinian reported by Irenaeus",
              "witnessId": "Irenaeus-I.4-I.5-NewAdvent",
              "position": {
                "generation": null,
                "sequence": null,
                "cyclicCoordinate": null,
                "orientation": null
              },
              "sourceRefs": [
                "angelic:irenaeus_i_4_response",
                "angelic:irenaeus_i_5"
              ],
              "exceptions": [
                "Source-role record scoped to I.4–5; matching names across recensions are not silently identified.",
                "I.4calls upperSophia herfather inname-etiology and hermother/firstSophia later. Preserve both textual role expressions without forcing a biological-sex model.",
                "Do not collapse upperSophia andAchamoth solely because the latter is also calledSophia."
              ],
              "assertionLayer": "source-assertion"
            },
