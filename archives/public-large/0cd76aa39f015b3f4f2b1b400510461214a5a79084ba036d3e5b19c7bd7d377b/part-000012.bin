        {
          "id": "bible:theographic:delaiah_1001",
          "nativeName": "Delaiah",
          "name": "Delaiah",
          "aliases": [],
          "unit": "Curated Biblical named-entity/person record",
          "sourceRecordKey": "delaiah_1001",
