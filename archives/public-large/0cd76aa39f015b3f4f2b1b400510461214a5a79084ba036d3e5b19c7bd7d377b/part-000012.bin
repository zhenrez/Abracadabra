          "unit": "Curated Biblical named-entity/person record",
          "sourceRecordKey": "kish_1784",
          "sourceRecordOrdinalOneBased": 1770,
          "sourceRefs": [
            "theographic:CSV/People.csv"
          ],
          "verseRefs": [
            "1Sam.9.1",
            "1Sam.9.3",
            "1Sam.10.11",
            "1Sam.10.21",
            "1Sam.14.51",
            "2Sam.21.14",
            "1Chr.8.30",
            "1Chr.8.33",
            "1Chr.9.36",
            "1Chr.9.39",
            "1Chr.12.1",
            "1Chr.26.28",
            "Acts.13.21"
          ],
          "genderAsCurated": "Male",
          "ambiguousAsCurated": true,
          "disambiguationNote": "Kish ((qish; Kis, Keis, \"bow,\" \"power\"): The name of five persons mentioned in the Bible: (1) The son of Abiel and the father of Saul, the first king of Israel. He was of the tribe of Benjamin, of the family of the Matrites (1 Samuel 9:1; 14:51; compare Acts 13:21; 1 Samuel 10:21). According to 1 Chronicles 8:33 and 9:39, \"Ner begat Kish\" By reading \"Ner begat Abner\" (compare 1 Samuel 14:51; 1 Chronicles 6:28), the difficulty is at least partly overcome. In 1 Chronicles 12:1, Kish is also mentioned as the father of Saul, and again in 2 Samuel 21:14, we are told that the sepulcher of Kish was located in the country of Benjamin, in Zela. His place of residence seems to have been at Gibeah. (2) Another Kish is mentioned (1 Chronicles 8:29; 9:35) as the son of Jeiel and his wife Maacah. He is usually supposed to be the uncle of Saul's father. (3) A Levite, the son of Mahli the Merarite (1 Chronicles 23:21; compare 24:29). (4) Another Merarite Levite in the time of Hezekiah (2 Chronicles 29:12). (5) The great-grandfather of Mordecai, of the tribe of Benjamin (Esther 2:5).)",
          "generation": null,
          "absoluteChronology": null,
          "musicalAssignment": null,
          "historicalIndividualIndependentlyConfirmed": false,
          "curatedChronologyNotAdopted": {
            "birthYear": "",
            "deathYear": "",
            "basis": "Maintainer follows modern Jones chronology; not substituted for received witness clocks."
          },
          "tradition": "Biblical curated/verse-local comparison",
          "witnessId": "Theographic-KJV-comparison",
          "position": {
            "generation": null,
            "sequence": 1770,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "assertionLayer": "curator-or-textual-occurrence",
          "exceptions": [
            "Kish ((qish; Kis, Keis, \"bow,\" \"power\"): The name of five persons mentioned in the Bible: (1) The son of Abiel and the father of Saul, the first king of Israel. He was of the tribe of Benjamin, of the family of the Matrites (1 Samuel 9:1; 14:51; compare Acts 13:21; 1 Samuel 10:21). According to 1 Chronicles 8:33 and 9:39, \"Ner begat Kish\" By reading \"Ner begat Abner\" (compare 1 Samuel 14:51; 1 Chronicles 6:28), the difficulty is at least partly overcome. In 1 Chronicles 12:1, Kish is also mentioned as the father of Saul, and again in 2 Samuel 21:14, we are told that the sepulcher of Kish was located in the country of Benjamin, in Zela. His place of residence seems to have been at Gibeah. (2) Another Kish is mentioned (1 Chronicles 8:29; 9:35) as the son of Jeiel and his wife Maacah. He is usually supposed to be the uncle of Saul's father. (3) A Levite, the son of Mahli the Merarite (1 Chronicles 23:21; compare 24:29). (4) Another Merarite Levite in the time of Hezekiah (2 Chronicles 29:12). (5) The great-grandfather of Mordecai, of the tribe of Benjamin (Esther 2:5).)"
          ],
          "globalSunnyAddress": null,
          "sourceOccurrenceRetained": true
