        {
          "id": "bible:theographic:eliashib_1093",
          "nativeName": "Eliashib",
          "name": "Eliashib",
          "aliases": [],
          "unit": "Curated Biblical named-entity/person record",
          "sourceRecordKey": "eliashib_1093",
          "sourceRecordOrdinalOneBased": 773,
          "sourceRefs": [
            "theographic:CSV/People.csv"
          ],
          "verseRefs": [
            "1Chr.3.24"
          ],
          "genderAsCurated": "Male",
          "ambiguousAsCurated": true,
          "disambiguationNote": "Eliashib (Hebrew: אֶלְיָשִׁיב‎ ’Elyāšîḇ, \"El restores\") the High Priest is mentioned in Nehemiah 12:10,22 and 3:1, 20-21,13:28 and possibly the Book of Ezra of the Hebrew Bible as (grand)father (Nehemiah 12:22) of the high priest Johanan (Ezra 10:6). Some also place him in different parts of Nehemiah including 12:23 and 13:4,7, but this is disputed. Nehemiah 3:20-21 places his home between the area of two working groups constructing the walls of Jerusalem on the south side of the city. He helped with the refortification of this wall (Neh 3:1). The size of his house indicated his wealth and high socio-economic status (Neh 3:23-21). This places him as someone who lived during the time of Nehemiah. In the year 445 BCE, Eliashib was the high priest when Nehemiah returned to Jerusalem in the 20th year of Artaxerxes I (Nehemiah 1:1, 2:1).[1]",
          "generation": null,
          "absoluteChronology": null,
          "musicalAssignment": null,
          "historicalIndividualIndependentlyConfirmed": false,
          "curatedChronologyNotAdopted": {
            "birthYear": "",
            "deathYear": "",
            "basis": "Maintainer follows modern Jones chronology; not substituted for received witness clocks."
          },
          "tradition": "Biblical curated/verse-local comparison",
          "witnessId": "Theographic-KJV-comparison",
          "position": {
            "generation": null,
            "sequence": 773,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "assertionLayer": "curator-or-textual-occurrence",
          "exceptions": [
            "Eliashib (Hebrew: אֶלְיָשִׁיב‎ ’Elyāšîḇ, \"El restores\") the High Priest is mentioned in Nehemiah 12:10,22 and 3:1, 20-21,13:28 and possibly the Book of Ezra of the Hebrew Bible as (grand)father (Nehemiah 12:22) of the high priest Johanan (Ezra 10:6). Some also place him in different parts of Nehemiah including 12:23 and 13:4,7, but this is disputed. Nehemiah 3:20-21 places his home between the area of two working groups constructing the walls of Jerusalem on the south side of the city. He helped with the refortification of this wall (Neh 3:1). The size of his house indicated his wealth and high socio-economic status (Neh 3:23-21). This places him as someone who lived during the time of Nehemiah. In the year 445 BCE, Eliashib was the high priest when Nehemiah returned to Jerusalem in the 20th year of Artaxerxes I (Nehemiah 1:1, 2:1).[1]"
          ],
          "globalSunnyAddress": null,
          "sourceOccurrenceRetained": true
        },
