              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B14",
              "type": "str",
              "value": "Kepler supplies 6 planets × 2 extrema = 12 termini, but each planet continuously traverses the states between its endpoints.",
