          "cells": [
            {
              "ref": "A212",
              "type": "str",
              "value": "Twelve four-triad grammar",
              "raw_value": "Twelve four-triad grammar",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B212",
              "type": "str",
              "value": "Chapter 6 also describes twelve as four triads—love, hate, life-giving and killing—but this factorization does not by itself assign pitch cosets.",
