              "style": "19"
            },
            {
              "ref": "C2",
              "type": "str",
              "value": "Gathas (Yasna 28–34, 43–51, 53)",
              "raw_value": "Gathas (Yasna 28–34, 43–51, 53)",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D2",
              "type": "str",
              "value": "Earliest stratum",
              "raw_value": "Earliest stratum",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E2",
              "type": "str",
              "value": "Ahura Mazda as supreme creator/orderer; Asha, Vohu Manah, Xshathra, Armaiti, Haurvatat, Ameretat and other principles appear as divine/ethical modalities.",
              "raw_value": "Ahura Mazda as supreme creator/orderer; Asha, Vohu Manah, Xshathra, Armaiti, Haurvatat, Ameretat and other principles appear as divine/ethical modalities.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F2",
              "type": "str",
              "value": "The Gathic set is not presented as the later closed, systematically mapped heptad; the number of divine principles is comparatively open.",
              "raw_value": "The Gathic set is not presented as the later closed, systematically mapped heptad; the number of divine principles is comparatively open.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "G2",
              "type": "str",
              "value": "Ethical dualism centers on Truth/Lie and the choice of twin spirits; later primordial-cosmic symmetry must not be back-projected.",
              "raw_value": "Ethical dualism centers on Truth/Lie and the choice of twin spirits; later primordial-cosmic symmetry must not be back-projected.",
              "formula": null,
