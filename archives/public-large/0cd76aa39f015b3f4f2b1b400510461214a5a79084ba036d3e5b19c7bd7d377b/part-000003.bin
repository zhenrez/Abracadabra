        {
          "row": 202,
          "cells": [
            {
              "ref": "A202",
              "type": "str",
              "value": "32-path architecture",
              "raw_value": "32-path architecture",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B202",
              "type": "str",
              "value": "The text explicitly decomposes 32 paths into 10 sefirot +22 foundation letters, and the 22 into 3 Mothers +7 Doubles +12 Simples.",
              "raw_value": "The text explicitly decomposes 32 paths into 10 sefirot +22 foundation letters, and the 22 into 3 Mothers +7 Doubles +12 Simples.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 203,
          "cells": [
            {
              "ref": "A203",
              "type": "str",
              "value": "231 gates",
              "raw_value": "231 gates",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B203",
              "type": "str",
              "value": "Twenty-two letters on a wheel produce 231 gates = C(22,2), the complete unordered pair-space. This is the strongest traditional textual match yet to Γ(B), the class's admissible relation/configuration space.",
              "raw_value": "Twenty-two letters on a wheel produce 231 gates = C(22,2), the complete unordered pair-space. This is the strongest traditional textual match yet to Γ(B), the class's admissible relation/configuration space.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 204,
          "cells": [
            {
              "ref": "A204",
              "type": "str",
              "value": "Nested hierarchy",
              "raw_value": "Nested hierarchy",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B204",
              "type": "str",
              "value": "Chapter 6 explicitly states one over three, three over seven, seven over twelve, with all bound one to another. This is the strongest direct nested-class witness in the corpus.",
              "raw_value": "Chapter 6 explicitly states one over three, three over seven, seven over twelve, with all bound one to another. This is the strongest direct nested-class witness in the corpus.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 205,
          "cells": [
            {
              "ref": "A205",
              "type": "str",
              "value": "Three mediation",
              "raw_value": "Three mediation",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B205",
              "type": "str",
              "value": "Three Mothers encode opposed Fire/Water with Air/Breath deciding between them.",
              "raw_value": "Three Mothers encode opposed Fire/Water with Air/Breath deciding between them.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 206,
          "cells": [
            {
              "ref": "A206",
              "type": "str",
              "value": "Seven result",
              "raw_value": "Seven result",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B206",
              "type": "str",
              "value": "Seven is explicitly non-flat: six extremities + Holy Palace center, and three opposite three + a deciding rule. This prospectively confirms the broad Zoroastrian 6+1 anchor after Irish/Welsh nonconfirmations.",
              "raw_value": "Seven is explicitly non-flat: six extremities + Holy Palace center, and three opposite three + a deciding rule. This prospectively confirms the broad Zoroastrian 6+1 anchor after Irish/Welsh nonconfirmations.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 207,
          "cells": [
            {
              "ref": "A207",
              "type": "str",
              "value": "Seven caution",
              "raw_value": "Seven caution",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B207",
              "type": "str",
              "value": "The special seventh is not thereby identified with a named Double letter, planet, tonic or Ahura Mazda-equivalent. Ontological role type remains distinct.",
              "raw_value": "The special seventh is not thereby identified with a named Double letter, planet, tonic or Ahura Mazda-equivalent. Ontological role type remains distinct.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
