        {
          "row": 42,
          "cells": [
            {
              "ref": "A42",
              "type": "str",
              "value": "Whole-class compression",
              "raw_value": "Whole-class compression",
              "formula": null,
              "formula_attributes": null,
              "style": "156"
            },
            {
              "ref": "B42",
              "type": "str",
              "value": "A separate agreement says each Vasu contributes one eighth of its energy to the one son who will live. Later the surviving child is identified as Dyu/Devavrata.",
              "raw_value": "A separate agreement says each Vasu contributes one eighth of its energy to the one son who will live. Later the surviving child is identified as Dyu/Devavrata.",
