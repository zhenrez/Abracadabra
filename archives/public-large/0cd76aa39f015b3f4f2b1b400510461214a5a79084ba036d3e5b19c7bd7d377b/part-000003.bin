        },
        {
          "row": 208,
          "cells": [
            {
              "ref": "A208",
              "type": "str",
              "value": "Twelve crosswalk",
              "raw_value": "Twelve crosswalk",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B208",
              "type": "str",
              "value": "Twelve Simples form a true positional index across zodiac signs, months and other World/Year/Person domains. This is a positive typed-crosswalk case, unlike Irish unaligned parallel twelves.",
              "raw_value": "Twelve Simples form a true positional index across zodiac signs, months and other World/Year/Person domains. This is a positive typed-crosswalk case, unlike Irish unaligned parallel twelves.",
              "formula": null,
              "formula_attributes": null,
