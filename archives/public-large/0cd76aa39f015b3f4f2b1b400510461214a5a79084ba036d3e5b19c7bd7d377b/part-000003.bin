        {
          "row": 12,
          "cells": [
            {
              "ref": "A12",
              "type": "str",
              "value": "Music-of-Spheres branch",
              "raw_value": "Music-of-Spheres branch",
              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B12",
              "type": "str",
              "value": "Added Philolaus/Pythagorean, Plato, Nicomachus, Ptolemy, Boethius, Fludd, Kepler, plus Aristotle as a 4→5 regime-boundary comparator.",
              "raw_value": "Added Philolaus/Pythagorean, Plato, Nicomachus, Ptolemy, Boethius, Fludd, Kepler, plus Aristotle as a 4→5 regime-boundary comparator.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 13,
          "cells": [
            {
              "ref": "A13",
              "type": "str",
              "value": "Direct line→circle precedent",
              "raw_value": "Direct line→circle precedent",
              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B13",
              "type": "str",
              "value": "Ptolemy explicitly compares the Greater Perfect System with the 12-sign zodiac and bends the musical line into a circle by identifying endpoints.",
              "raw_value": "Ptolemy explicitly compares the Greater Perfect System with the 12-sign zodiac and bends the musical line into a circle by identifying endpoints.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 14,
          "cells": [
            {
              "ref": "A14",
              "type": "str",
              "value": "Dynamic precedent",
              "raw_value": "Dynamic precedent",
              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B14",
              "type": "str",
              "value": "Kepler supplies 6 planets × 2 extrema = 12 termini, but each planet continuously traverses the states between its endpoints.",
              "raw_value": "Kepler supplies 6 planets × 2 extrema = 12 termini, but each planet continuously traverses the states between its endpoints.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 15,
          "cells": [
            {
              "ref": "A15",
              "type": "str",
              "value": "Vertical scale precedent",
              "raw_value": "Vertical scale precedent",
              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B15",
              "type": "str",
              "value": "Fludd's monochord puts elements, planetary spheres, fixed stars and upper regions on one proportional line with nested octave/fifth/fourth relations.",
              "raw_value": "Fludd's monochord puts elements, planetary spheres, fixed stars and upper regions on one proportional line with nested octave/fifth/fourth relations.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 16,
          "cells": [
            {
              "ref": "A16",
              "type": "str",
              "value": "Research rule",
              "raw_value": "Research rule",
              "formula": null,
              "formula_attributes": null,
              "style": "48"
            },
            {
              "ref": "B16",
              "type": "str",
              "value": "Do not treat repeated numbers as identity. Preserve whether a number is a peer count, pair count, endpoint count, face count, partition, resolution, or container.",
              "raw_value": "Do not treat repeated numbers as identity. Preserve whether a number is a peer count, pair count, endpoint count, face count, partition, resolution, or container.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 18,
          "cells": [
            {
              "ref": "A18",
              "type": "str",
              "value": "Salted-testimony protocol",
              "raw_value": "Salted-testimony protocol",
              "formula": null,
              "formula_attributes": null,
              "style": "60"
            },
            {
              "ref": "B18",
              "type": "str",
              "value": "Public polemic is evidence of what an author chose to say publicly, not automatically a complete record of private intent. Keep public claim, built structure, private correspondence, and later interpretation separate.",
              "raw_value": "Public polemic is evidence of what an author chose to say publicly, not automatically a complete record of private intent. Keep public claim, built structure, private correspondence, and later interpretation separate.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 19,
          "cells": [
            {
              "ref": "A19",
              "type": "str",
              "value": "Kepler–Fludd status",
              "raw_value": "Kepler–Fludd status",
              "formula": null,
              "formula_attributes": null,
              "style": "60"
            },
            {
              "ref": "B19",
              "type": "str",
              "value": "Secret collaboration is currently unsupported; genuine polemic and adversarial co-development both fit the evidence well. A partially performative polemic remains possible but requires positive private evidence.",
              "raw_value": "Secret collaboration is currently unsupported; genuine polemic and adversarial co-development both fit the evidence well. A partially performative polemic remains possible but requires positive private evidence.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 20,
          "cells": [
            {
              "ref": "A20",
              "type": "str",
              "value": "Key discriminators",
              "raw_value": "Key discriminators",
              "formula": null,
              "formula_attributes": null,
              "style": "60"
            },
            {
              "ref": "B20",
              "type": "str",
              "value": "Direct letters, manuscript provenance, pre-publication exchange, shared cipher/key, unique cross-dependencies, or private admissions would materially change the secret-coordination hypothesis.",
              "raw_value": "Direct letters, manuscript provenance, pre-publication exchange, shared cipher/key, unique cross-dependencies, or private admissions would materially change the secret-coordination hypothesis.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 21,
          "cells": [
            {
              "ref": "A21",
              "type": "str",
              "value": "Do not overcorrect",
              "raw_value": "Do not overcorrect",
              "formula": null,
              "formula_attributes": null,
              "style": "60"
            },
            {
              "ref": "B21",
              "type": "str",
              "value": "Complementary structures can emerge from sincere disagreement. We do not need 'cahoots' for the exchange to function as a distributed collaboration.",
              "raw_value": "Complementary structures can emerge from sincere disagreement. We do not need 'cahoots' for the exchange to function as a distributed collaboration.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 23,
          "cells": [
            {
              "ref": "A23",
              "type": "str",
              "value": "Print-network overlap",
              "raw_value": "Print-network overlap",
              "formula": null,
              "formula_attributes": null,
              "style": "70"
            },
            {
              "ref": "B23",
              "type": "str",
              "value": "Concrete lead: in 1621 both Fludd's Veritatis Proscenium and Kepler's Prodromus/Mysterium reissue used Frankfurt printer Erasmus Kempffer, though for different publishing patrons (de Bry vs Tampach). The 1622/23 replies continue through these overlapping channels.",
              "raw_value": "Concrete lead: in 1621 both Fludd's Veritatis Proscenium and Kepler's Prodromus/Mysterium reissue used Frankfurt printer Erasmus Kempffer, though for different publishing patrons (de Bry vs Tampach). The 1622/23 replies continue through these overlapping channels.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 24,
          "cells": [
            {
              "ref": "A24",
              "type": "str",
              "value": "Interpretation",
              "raw_value": "Interpretation",
              "formula": null,
              "formula_attributes": null,
              "style": "70"
            },
            {
              "ref": "B24",
              "type": "str",
              "value": "This materially strengthens 'they had rapid access to each other's work / shared book-trade intermediaries.' It does NOT by itself strengthen 'secretly coordinated message' very much; printers commonly served multiple intellectual camps.",
              "raw_value": "This materially strengthens 'they had rapid access to each other's work / shared book-trade intermediaries.' It does NOT by itself strengthen 'secretly coordinated message' very much; printers commonly served multiple intellectual camps.",
