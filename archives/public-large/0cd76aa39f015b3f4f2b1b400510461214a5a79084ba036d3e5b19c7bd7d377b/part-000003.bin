              "style": "600"
            },
            {
              "ref": "B201",
              "type": "str",
              "value": "The big test was run against the pre-registered controls; recension families were not silently harmonized.",
              "raw_value": "The big test was run against the pre-registered controls; recension families were not silently harmonized.",
