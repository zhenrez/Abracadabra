            },
            {
              "ref": "E4",
              "type": "str",
              "value": "Sixteen good lands created by Ahura Mazda are answered one-for-one by sixteen counter-created plagues/evils of Angra Mainyu.",
              "raw_value": "Sixteen good lands created by Ahura Mazda are answered one-for-one by sixteen counter-created plagues/evils of Angra Mainyu.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F4",
              "type": "str",
              "value": "Exact paired creation/counter-creation grammar over 16 cases.",
              "raw_value": "Exact paired creation/counter-creation grammar over 16 cases.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "G4",
              "type": "str",
              "value": "Do not read the sequence as migration history; the source itself does not establish that inference.",
