              "style": "550"
            },
            {
              "ref": "B186",
              "type": "str",
              "value": "Two identities exchange visible form and governing role for one year, then recover their own forms. This is the cleanest current witness that identity, presentation and role are separable.",
              "raw_value": "Two identities exchange visible form and governing role for one year, then recover their own forms. This is the cleanest current witness that identity, presentation and role are separable.",
