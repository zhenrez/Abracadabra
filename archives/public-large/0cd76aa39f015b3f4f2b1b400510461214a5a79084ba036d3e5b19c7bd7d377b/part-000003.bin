              "style": "19"
            },
            {
              "ref": "E3",
              "type": "str",
              "value": "The 'Bounteous Immortals' become a named/formalized worship group; traditions stress one mind, voice and act under one creator.",
              "raw_value": "The 'Bounteous Immortals' become a named/formalized worship group; traditions stress one mind, voice and act under one creator.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F3",
              "type": "str",
              "value": "Divine beings become more explicitly personified while still functioning as powers/qualities.",
              "raw_value": "Divine beings become more explicitly personified while still functioning as powers/qualities.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "G3",
              "type": "str",
              "value": "Intermediate scale between Gathic ethical modalities and later Pahlavi cosmological systematization.",
