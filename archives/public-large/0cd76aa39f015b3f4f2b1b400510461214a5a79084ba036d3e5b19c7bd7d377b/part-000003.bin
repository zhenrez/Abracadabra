              "style": "156"
            },
            {
              "ref": "B41",
              "type": "str",
              "value": "Dyu is identified as the one whose deed caused the curse; the other Vasus assisted. Vasistha differentiates Dyu's human fate before Bhishma's downstream career.",
              "raw_value": "Dyu is identified as the one whose deed caused the curse; the other Vasus assisted. Vasistha differentiates Dyu's human fate before Bhishma's downstream career.",
