          "cells": [
            {
              "ref": "A211",
              "type": "str",
              "value": "Factor-transpose",
              "raw_value": "Factor-transpose",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B211",
              "type": "str",
              "value": "Irish proved transpose arithmetic can be meaningless; Gra SY supplies a late positive case because the transpose groups real edge types. Carrier/coordinate proof remains mandatory.",
              "raw_value": "Irish proved transpose arithmetic can be meaningless; Gra SY supplies a late positive case because the transpose groups real edge types. Carrier/coordinate proof remains mandatory.",
              "formula": null,
