            }
          ]
        },
        {
          "row": 209,
          "cells": [
            {
              "ref": "A209",
              "type": "str",
              "value": "Inherited music geometry",
              "raw_value": "Inherited music geometry",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B209",
              "type": "str",
              "value": "Because the Twelve map in order to zodiac signs, inherited zodiac triplicities and oppositions induce exact MUS-4×3 and MUS-6×2 letter sets; these remain one historical lineage, not new independent votes.",
              "raw_value": "Because the Twelve map in order to zodiac signs, inherited zodiac triplicities and oppositions induce exact MUS-4×3 and MUS-6×2 letter sets; these remain one historical lineage, not new independent votes.",
              "formula": null,
              "formula_attributes": null,
              "style": "18"
            }
          ]
        },
        {
          "row": 210,
          "cells": [
            {
              "ref": "A210",
              "type": "str",
              "value": "3×4 result",
              "raw_value": "3×4 result",
              "formula": null,
              "formula_attributes": null,
              "style": "600"
            },
            {
              "ref": "B210",
              "type": "str",
              "value": "Earliest-recoverable boundary order does not reproduce the diminished cosets. The late Gra boundary matrix does transpose into three meaningful quartets matching MUS-3×4 indices, giving qualified late support only.",
              "raw_value": "Earliest-recoverable boundary order does not reproduce the diminished cosets. The late Gra boundary matrix does transpose into three meaningful quartets matching MUS-3×4 indices, giving qualified late support only.",
              "formula": null,
