              "formula": null,
              "formula_attributes": null,
              "style": "13"
            },
            {
              "ref": "B3",
              "type": "str",
              "value": "Build independent generative hierarchies first; then compare structure, generation rules, trait inheritance, counts, and failure residuals across systems.",
              "raw_value": "Build independent generative hierarchies first; then compare structure, generation rules, trait inheritance, counts, and failure residuals across systems.",
              "formula": null,
