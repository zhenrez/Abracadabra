              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D7",
              "type": "str",
              "value": "Exodus 24 names seventy elders, plus Aaron, Nadab and Abihu. Moses later sets out with Joshua and ultimately enters the cloud; the text does not give '72 elders.'",
              "raw_value": "Exodus 24 names seventy elders, plus Aaron, Nadab and Abihu. Moses later sets out with Joshua and ultimately enters the cloud; the text does not give '72 elders.'",
