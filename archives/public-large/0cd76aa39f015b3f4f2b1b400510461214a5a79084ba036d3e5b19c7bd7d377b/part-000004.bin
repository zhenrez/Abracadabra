              "formula": null,
              "formula_attributes": null,
              "style": "60"
            },
            {
              "ref": "B20",
              "type": "str",
              "value": "Direct letters, manuscript provenance, pre-publication exchange, shared cipher/key, unique cross-dependencies, or private admissions would materially change the secret-coordination hypothesis.",
