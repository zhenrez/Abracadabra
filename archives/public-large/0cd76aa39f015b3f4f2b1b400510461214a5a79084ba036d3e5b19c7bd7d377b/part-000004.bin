              "raw_value": "REJECT AS GENERAL SCIENTIFIC LAW",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D5",
              "type": "str",
              "value": "Dynamical systems can change regime through forcing, instability, bifurcation, noise, feedback, parameter drift, etc.; prime cardinality has no universal causal privilege.",
