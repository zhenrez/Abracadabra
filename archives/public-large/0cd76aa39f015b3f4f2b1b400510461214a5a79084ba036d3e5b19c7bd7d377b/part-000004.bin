              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B6",
              "type": "str",
              "value": "13 is a Fibonacci threshold where nature locks into phi",
              "raw_value": "13 is a Fibonacci threshold where nature locks into phi",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C6",
              "type": "str",
              "value": "REJECT SPECIAL-THRESHOLD CLAIM / KEEP ORDINARY FIBONACCI FACT",
              "raw_value": "REJECT SPECIAL-THRESHOLD CLAIM / KEEP ORDINARY FIBONACCI FACT",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D6",
              "type": "str",
              "value": "13 is a Fibonacci number and 21/13≈1.61538 approaches φ≈1.61803, but neighboring Fibonacci ratios also converge. No unique lock-in occurs at 13.",
              "raw_value": "13 is a Fibonacci number and 21/13≈1.61538 approaches φ≈1.61803, but neighboring Fibonacci ratios also converge. No unique lock-in occurs at 13.",
              "formula": null,
