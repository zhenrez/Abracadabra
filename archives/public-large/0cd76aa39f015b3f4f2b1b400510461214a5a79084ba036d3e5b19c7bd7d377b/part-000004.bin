              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B2",
              "type": "str",
              "value": "Ophiuchus is a real 13th constellation crossed by the ecliptic",
              "raw_value": "Ophiuchus is a real 13th constellation crossed by the ecliptic",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C2",
              "type": "str",
              "value": "SUPPORTED ASTRONOMICALLY",
              "raw_value": "SUPPORTED ASTRONOMICALLY",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D2",
              "type": "str",
              "value": "The Sun/ecliptic passes through Ophiuchus; astronomical constellations are irregular regions, while zodiac signs are 12 equal 30° sectors.",
              "raw_value": "The Sun/ecliptic passes through Ophiuchus; astronomical constellations are irregular regions, while zodiac signs are 12 equal 30° sectors.",
