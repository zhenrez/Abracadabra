              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B4",
              "type": "str",
              "value": "13 creates prime-number friction in 12/72 systems",
              "raw_value": "13 creates prime-number friction in 12/72 systems",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C4",
              "type": "str",
              "value": "REFINE — MATHEMATICALLY REAL AS COPRIME GRID MISMATCH",
              "raw_value": "REFINE — MATHEMATICALLY REAL AS COPRIME GRID MISMATCH",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D4",
              "type": "str",
              "value": "13 is prime, but the relevant property is gcd(13,12)=gcd(13,72)=1. Equal 13-sector and 12/72-sector grids share no interior boundaries and require 156/936 subdivision states respectively for common refinement.",
              "raw_value": "13 is prime, but the relevant property is gcd(13,12)=gcd(13,72)=1. Equal 13-sector and 12/72-sector grids share no interior boundaries and require 156/936 subdivision states respectively for common refinement.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E4",
              "type": "str",
              "value": "Mathematical",
              "raw_value": "Mathematical",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F4",
              "type": "str",
              "value": "Call this coprime overlay / phase mismatch, not physical friction.",
              "raw_value": "Call this coprime overlay / phase mismatch, not physical friction.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
