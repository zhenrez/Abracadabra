              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B3",
              "type": "str",
              "value": "Ophiuchus is a zero-degree vacuum between Scorpio and Sagittarius",
              "raw_value": "Ophiuchus is a zero-degree vacuum between Scorpio and Sagittarius",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C3",
              "type": "str",
              "value": "REJECT AS ASTRONOMICAL CLAIM / RETAIN AS MODEL METAPHOR",
              "raw_value": "REJECT AS ASTRONOMICAL CLAIM / RETAIN AS MODEL METAPHOR",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D3",
              "type": "str",
              "value": "There is no zero-width gap. Ophiuchus occupies an irregular finite sky region and much of its ecliptic span lies in the longitude range tropical astrology calls Sagittarius.",
              "raw_value": "There is no zero-width gap. Ophiuchus occupies an irregular finite sky region and much of its ecliptic span lies in the longitude range tropical astrology calls Sagittarius.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
