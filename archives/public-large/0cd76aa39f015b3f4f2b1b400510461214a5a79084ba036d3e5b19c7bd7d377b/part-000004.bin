              "type": "str",
              "value": "Experimental geometry only",
              "raw_value": "Experimental geometry only",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F3",
              "type": "str",
              "value": "If used, define an explicit discontinuity operator rather than claiming one exists in the sky.",
              "raw_value": "If used, define an explicit discontinuity operator rather than claiming one exists in the sky.",
