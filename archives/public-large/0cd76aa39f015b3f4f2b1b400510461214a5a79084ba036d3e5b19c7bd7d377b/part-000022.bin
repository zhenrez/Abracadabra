        {
          "id": "chinese-expanded:hkco:family:bowed",
          "nativeName": "bowed",
          "aliases": [],
          "unit": "HKCO-playing-technique-family",
          "tradition": "Chinese",
          "witnessId": "HKCO2025-2026",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
          },
          "sourceRefs": [
            "chinese-expanded:hkco-bowed"
          ],
          "assertionLayer": "source-assertion",
          "exceptions": [],
          "evidence": {
            "sourceId": "chinese-expanded:hkco-bowed",
            "normalizedTextPath": "state/research/chinese-expanded/hkco-bowed.normalized.txt",
            "startCodePoint": 3944,
            "endCodePointExclusive": 5078,
            "text": "The configuration of the Hong Kong Chinese Orchestra incorporates the erhu, gaohu,zhonghu, gehu and bass gehu. The Orchestra may also incorporate other types of bowed-string instruments such as the banhu, jinghu, yehu and leiqin depending on the repertory. Contact Us Copyright © 2026 HKCO View Desktop Version Your Support The HKCO is a non-profit organization. It is through your support that we can continue to make life beautiful, with arts, music, and a thankful heart. Sponsorship & Donation Advertisement Subscribe Newsletter Sign up for emails about special offers, discounts, latest news, and more. Go Please enter a valid email. Friends of HKCO Download Application Form Contact Us Copyright © 2026 HKCO View Mobile Version //Google Analytic (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){ (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o), m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m) })(window,document,'script','https://www.google-analytics.com/analytics.js','ga'); ga('create', 'UA-76405764-1', 'auto'); ga('send', 'pageview');\n"
          }
        },
        {
