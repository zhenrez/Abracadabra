        {
          "id": "chinese-expanded:lam:mode:7:3",
          "nativeName": "7 set 徵 final",
          "aliases": [],
          "unit": "Lam-source-defined-mode-final-context",
          "tradition": "Chinese",
          "witnessId": "Lam2024",
          "position": {
            "generation": null,
            "sequence": null,
            "cyclicCoordinate": null,
            "orientation": null
