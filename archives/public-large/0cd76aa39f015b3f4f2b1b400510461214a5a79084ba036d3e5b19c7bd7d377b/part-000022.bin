        {
          "id": "chinese-expanded:hkco:family:wind",
          "nativeName": "wind",
          "aliases": [],
          "unit": "HKCO-playing-technique-family",
          "tradition": "Chinese",
          "witnessId": "HKCO2025-2026",
          "position": {
            "generation": null,
