        {
          "id": "chinese-expanded:hkco:family:percussion",
          "nativeName": "percussion",
          "aliases": [],
          "unit": "HKCO-playing-technique-family",
          "tradition": "Chinese",
          "witnessId": "HKCO2025-2026",
          "position": {
            "generation": null,
