      "content_sha256": "4a1009c32f834021ab42d4bb92916a7d7d574a94418684ffb70944e54ff7aada",
      "headers": [
        "Language and identified presentation",
        "Relevant wording",
        "Consequence for the musical timing record"
      ],
      "rows": [
        [
          "**Hebrew - Mechon-Mamre**",
          "וְלֹא יָסָפוּ",
          "The presentation reads this as no further prophecy; reception evidence preserves another interpretation. Keep the reading identified."
        ],
        [
          "**Greek - Septuagint text presented by BiblIndex**",
          "οὐκέτι προσέθεντο",
          "Expresses no further adding or repetition; it does not provide a measured duration or exact cutoff."
        ],
        [
          "**Aramaic - Onkelos, accessed through Sefaria’s Metsudah text**",
          "וְלָא פַסְקִין",
          "A noncessation reading. A universal elders-stop entry would overwrite it."
        ],
        [
          "**Latin - Clementine Vulgate**",
          "nec ultra cessaverunt",
          "Also a noncessation reading."
        ],
        [
          "**Arabic - Van Dyck**",
          "وَلَكِنَّهُمْ لَمْ يَزِيدُوا",
          "Preserves a no-more/addition reading in this identified translation."
        ]
      ],
      "occurrences": [
