    {
      "id": "alignment-table-e8c1b657c1e6b395",
      "content_sha256": "e8c1b657c1e6b395b1fc01a16bdbe2a7511c8a2cd5aff287a21716a5fae6ca9d",
      "headers": [
        "Human account",
        "Mathematical musical consequence"
      ],
      "rows": [
        [
          "Moses carries responsibility for the people without being their biological parent.",
          "A governing or supporting relationship must not become a biological-generation edge."
        ],
        [
          "Existing elders are brought into shared responsibility.",
          "Selection and participation do not create new entities."
        ],
        [
          "The burden is to be shared with Moses.",
          "This passage does not enact his replacement. Succession and shared orchestration remain different operations."
        ]
      ],
      "occurrences": [
        {
          "source_id": "7d5a026c9df7d3fdf06382c966729a7cf3da22dbc4a1276c9f809f7a139ce965",
