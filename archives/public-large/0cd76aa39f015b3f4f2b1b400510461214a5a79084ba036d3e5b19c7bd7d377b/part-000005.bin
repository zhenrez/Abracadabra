      ],
      "rows": [
        [
          "4/5 → 5/6 telescoping gives SUN kernel",
          "Falsified: no 6-fold structure"
        ],
        [
          "Chiodo reconstruction is authoritative",
          "Falsified: user determined Chiodo wrong; all Chiodo results quarantined"
        ],
        [
          "74 faces = 2 × 37 reveals duality",
          "Falsified: 27 triple concurrences, not 37"
        ],
        [
          "3 flagged triples are geometric failures",
          "False alarm: checker defect, not geometry"
        ],
        [
          "Persistence alone forces φ",
          "Falsified: $s_{n+1} = 2 s_n + 1 \\cdot s_{n-1}$ gives $1+\\sqrt{2}$, not φ"
        ],
        [
          "Fibonacci emerges from 4/8/12/16 arithmetic progression",
          "Falsified: charpoly $(\\lambda-1)^2$, not golden"
        ],
        [
          "Four yantra counts closed under R, L, O",
          "False: $R(16) = 32/3 \\notin \\{4,8,12,16\\}$"
        ],
        [
