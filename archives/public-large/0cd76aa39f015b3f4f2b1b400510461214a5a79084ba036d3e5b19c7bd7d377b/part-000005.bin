      ],
      "rows": [
        [
          "Aion as encompassing whole",
          "Totality distinguished from its members",
          "Counting the whole as an extra ordinary member"
        ],
        [
          "Two distinct $1$ positions",
          "Equal size does not imply identical role",
          "Merging relationally distinct origins"
        ],
        [
          "First syzygy includes Silence",
