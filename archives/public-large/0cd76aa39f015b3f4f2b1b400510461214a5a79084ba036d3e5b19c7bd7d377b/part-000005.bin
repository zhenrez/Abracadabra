      "headers": [
        "Anchor",
        "What it fixes",
        "What follows"
      ],
      "rows": [
        [
          "**Void → Silence**",
          "Conditions before manifested sound",
          "Silence is not a missing note or necessarily an extra entity"
        ],
        [
          "**Aion**",
          "Encompassing temporal whole",
          "The whole must not be counted again as one of its constituents"
