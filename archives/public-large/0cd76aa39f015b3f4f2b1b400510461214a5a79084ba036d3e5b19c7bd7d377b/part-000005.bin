    {
      "id": "alignment-table-ea51205cfd5e25f2",
      "content_sha256": "ea51205cfd5e25f2e0f9afca3632e47025451b4e6edd2c3d98acb796395db6fd",
      "headers": [
        "Symbol",
        "Was",
        "Corrected to",
        "Basis"
      ],
      "rows": [
        [
          "**Aleph**",
          "First letter; value 1; Tarot = Magician (I)",
          "**Reference/operator; zero-state; Tarot = Fool (0)**",
          "Sefer 3: mediates Mem and Shin. SUN: $2/3$ is log-midpoint of $1/2$ and $8/9$. Operator role, not first-of-22."
        ],
        [
          "**Mem**",
          "Water element, third mother",
          "**$4/3$ reciprocal pole; pitch $8/9$; lowest**",
          "SUN ratios under pitch-height convention"
        ],
        [
          "**Shin**",
          "Fire element, third mother",
          "**$3/4$ reciprocal pole; pitch $1/2$; highest**",
          "SUN ratios under pitch-height convention"
        ],
        [
          "**The three mothers**",
          "Three equivalent generators",
          "**One reference + two reciprocal operations**",
          "Exact: $(2/3)^2 = (1/2)(8/9)$; $3/4 \\cdot 4/3 = 1$"
        ],
        [
          "**231 gates**",
          "The Sefer gate count",
          "**Letter-pair count for 22 unweighted letters.** Activated/weighted count = **233**; covering count $N(12)$ = **233**",
          "$231 = \\binom{22}{2}$; $233 = 231 + 2$ (Aleph's mediations) = $N(12)$"
        ],
        [
          "**Aleph-deleted count**",
          "Confused with 231",
          "**210** = $\\binom{21}{2}$. Deletion ≠ deactivation",
          "EMET→MET is deletion; activation toggle is separate"
        ],
        [
          "**Yaldabaoth**",
          "13th note; higher octave",
          "**Material bass entry; F_lower**",
          "First mechanical sound requires bass; $(RL)^{-1}$ from F_upper"
        ],
        [
          "**Sophia**",
          "\"Fallen aeon\"",
          "**Seam at 12/22/30; F_upper**",
          "12th Duodecad, 22nd Decad+Duodecad, 30th Pleroma"
        ],
        [
          "**Sabaoth**",
          "New Yaldabaoth",
          "**C_lower, fifth above Yaldabaoth**",
          "$R$ from F_lower = $3/2$ frequency = fifth up"
        ],
        [
          "**Shem's middle reversal**",
          "Same as mother reordering",
          "**Involution (order 2) on middle row only**",
          "$\\rho^2 = I$, distinct from 3-cycle mother order"
        ],
        [
          "**Mother reordering**",
          "\"Inversion\"",
          "**3-cycle (order 3)**",
          "$(\\text{Shin},\\text{Aleph},\\text{Mem}) \\to (\\text{Aleph},\\text{Mem},\\text{Shin})$, $\\pi^3 = I$"
        ],
        [
          "**Rahu–Ketu**",
          "Two dark planets; one slot",
          "**Opposite lunar nodes, 180° apart**",
          "Eclipse geometry; ascending vs. descending"
        ],
        [
          "**22 / 23 / 24**",
          "One correct count",
          "**Three counting levels: 22 letters, 27 graphic forms, 30 sound realizations**",
          "22 + 5 final forms = 27; 22 + 7 doubles + 1 Shin/Sin = 30"
        ],
        [
          "**7-headed dragon**",
          "= 7 chakras",
          "**7 heads + 10 horns + 7 diadems; must preserve all attributes**",
          "Rev 12:3, 12:9; reduction to 7 loses structure"
        ],
        [
          "**Lucifer**",
          "= Satan",
          "**Morning-star designation (Venus); used of Jesus (Rev 22:16); later moral reassignment**",
          "Isaiah 14:12 *Helel*; 2 Pet 1:19 Vulgate; not originally Satan"
        ],
        [
          "**Four triads / six syzygies**",
          "Two competing organizations",
          "**Both on the cube's 12 edges; flip-two involution preserves both**",
          "Explicit construction verified"
        ],
        [
          "**Chinese 8/10/12**",
          "= Valentinian 8/10/12",
          "**Same counts, different operations** (trigrams vs. syzygies; stems vs. Decad; branches vs. Duodecad)",
          "Operation types verified"
        ],
        [
          "**Three 72s**",
          "One structure",
          "**Three operations: Shem (extraction), Sabaoth court (office), Goetia (catalogue)**",
          "Equal population, different invariants"
        ],
        [
          "**Three 6+6s**",
          "One pattern",
          "**Titans (unpaired), Cronus children (grouped FFF→MMM), Valentinian (alternating MF)**",
          "Three distinct operations"
        ],
        [
          "**Sabbath / Sabaoth**",
          "Same word",
          "**Different roots; 7→rest→8 functional sequence survives**",
          "שַׁבָּת vs. צְבָאוֹת"
        ],
        [
          "**Venus names**",
          "Three mothers",
          "**One identity, two manifestations (Phosphoros/Eosphoros = morning; Hesperos = evening)**",
          "Astronomy"
        ]
      ],
