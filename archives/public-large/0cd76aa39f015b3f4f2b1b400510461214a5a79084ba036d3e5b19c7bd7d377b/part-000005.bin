    {
      "id": "alignment-table-ff49cd8fc7d1275f",
      "content_sha256": "ff49cd8fc7d1275f7e1549beb2e0d0d6c92ddfacbd4d6694c666a189858b341f",
      "headers": [
        "Predictive capability",
        "SUN/W72",
        "What SOL72 should add"
      ],
      "rows": [
        [
          "**1\\. Shem letter relationships**",
          "Operates on 72 coordinates",
          "Predicts which of the 72 three-letter names share structural relationships, before inspecting their traditional associations"
        ],
        [
          "**2\\. Angelic hierarchies**",
          "Knows musical positions",
          "Predicts which angelic offices or groups correspond to particular positions, relationships, or transitions"
        ],
        [
          "**3\\. Demonic hierarchies**",
          "Knows the 72-state carrier",
          "Tests whether the 72 Goetic spirits can be related to the Shem without arbitrarily pairing entries by index"
        ],
        [
          "**4\\. Generational expansion**",
          "Repeats or transforms harmonic states",
          "Predicts which relationships persist when populations expand to 200, 365, or other source-attested counts"
        ],
        [
          "**5\\. Authority and succession**",
          "Calculates interval transformations",
          "Predicts structural changes associated with Yaldabaoth, Sabaoth, Death, and their subordinate authorities"
        ],
        [
          "**6\\. Descent to Adam**",
          "No native historical genealogy",
          "Predicts which ancestral, creative, and animating relationships survive the transition into humanity"
        ]
      ],
