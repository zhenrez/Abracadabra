          "False: $A_4$ non-abelian, no order-4 element"
        ],
        [
          "$\\mathbb{Z}_{48} \\cong \\mathbb{Z}_4 \\times \\mathbb{Z}_{12}$",
          "False: max order 12 vs 48"
        ],
        [
          "φ emerges from cyclic shift algebra",
          "False: φ $\\notin \\mathbb{Q}(\\zeta_{12})$"
        ],
        [
          "Fibre adjacency is type-preserving",
          "False: reflection exchanges $H_8 \\leftrightarrow H_{12}$"
        ],
        [
          "Phonetic evidence proves the Fibonacci substitution",
          "False: only Time shows consistent gaps; Memory does not"
