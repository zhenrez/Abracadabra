              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B6",
              "type": "str",
              "value": "Fludd copied/derived from Kepler secretly",
              "raw_value": "Fludd copied/derived from Kepler secretly",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C6",
              "type": "str",
              "value": "Fludd used Kepler's unpublished or prior ideas while presenting an independent system.",
              "raw_value": "Fludd used Kepler's unpublished or prior ideas while presenting an independent system.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D6",
              "type": "str",
              "value": "Would require access before publication or unique dependence on Kepler-specific constructions.",
              "raw_value": "Would require access before publication or unique dependence on Kepler-specific constructions.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E6",
              "type": "str",
              "value": "Kepler himself says he saw Fludd's 1617/1618 publications before publishing his 1619 appendix, which runs opposite to this simple version.",
              "raw_value": "Kepler himself says he saw Fludd's 1617/1618 publications before publishing his 1619 appendix, which runs opposite to this simple version.",
