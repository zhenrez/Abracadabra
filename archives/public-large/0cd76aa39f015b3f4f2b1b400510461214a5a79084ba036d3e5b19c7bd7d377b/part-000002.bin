        {
          "row": 2,
          "cells": [
            {
              "ref": "A2",
              "type": "str",
              "value": "HYP-1",
              "raw_value": "HYP-1",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B2",
              "type": "str",
              "value": "Genuine independent polemic",
              "raw_value": "Genuine independent polemic",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C2",
              "type": "str",
              "value": "They independently developed overlapping cosmic-harmony systems and sincerely disagreed about method/epistemology.",
              "raw_value": "They independently developed overlapping cosmic-harmony systems and sincerely disagreed about method/epistemology.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D2",
              "type": "str",
              "value": "Public technical disagreement; multiple rounds of rebuttal; Kepler's private-network comments; different methods; no known joint manuscript.",
              "raw_value": "Public technical disagreement; multiple rounds of rebuttal; Kepler's private-network comments; different methods; no known joint manuscript.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E2",
              "type": "str",
              "value": "Explains all observed evidence with few extra assumptions.",
              "raw_value": "Explains all observed evidence with few extra assumptions.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F2",
              "type": "str",
              "value": "Current leading explanation",
              "raw_value": "Current leading explanation",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "G2",
              "type": "str",
              "value": "High",
              "raw_value": "High",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 3,
          "cells": [
            {
              "ref": "A3",
              "type": "str",
              "value": "HYP-2",
              "raw_value": "HYP-2",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B3",
              "type": "str",
              "value": "Adversarial co-development",
              "raw_value": "Adversarial co-development",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C3",
              "type": "str",
              "value": "They were genuinely opposed but the exchange functioned as a distributed collaboration: each forced the other to sharpen and publish complementary pieces.",
              "raw_value": "They were genuinely opposed but the exchange functioned as a distributed collaboration: each forced the other to sharpen and publish complementary pieces.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D3",
              "type": "str",
              "value": "Four-year publication dialogue; explicit agreement/disagreement framing; reciprocal technical engagement; final systems become mutually informative.",
              "raw_value": "Four-year publication dialogue; explicit agreement/disagreement framing; reciprocal technical engagement; final systems become mutually informative.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E3",
              "type": "str",
              "value": "Does not require secret intent; 'collaboration' is emergent rather than coordinated.",
              "raw_value": "Does not require secret intent; 'collaboration' is emergent rather than coordinated.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F3",
              "type": "str",
              "value": "Strongly plausible",
              "raw_value": "Strongly plausible",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "G3",
              "type": "str",
              "value": "High",
              "raw_value": "High",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            }
          ]
        },
        {
          "row": 4,
          "cells": [
            {
              "ref": "A4",
              "type": "str",
              "value": "HYP-3",
              "raw_value": "HYP-3",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B4",
              "type": "str",
              "value": "Partially performative / strategically salted polemic",
              "raw_value": "Partially performative / strategically salted polemic",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C4",
              "type": "str",
              "value": "Some public hostility was exaggerated, theatrical, reputational, or coded for different audiences while substantive exchange continued underneath.",
              "raw_value": "Some public hostility was exaggerated, theatrical, reputational, or coded for different audiences while substantive exchange continued underneath.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D4",
              "type": "str",
              "value": "Fludd's explicitly theatrical title; early-modern polemical conventions; shared harmonic subject; possible private correspondence reported by secondary sources.",
              "raw_value": "Fludd's explicitly theatrical title; early-modern polemical conventions; shared harmonic subject; possible private correspondence reported by secondary sources.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E4",
              "type": "str",
              "value": "Needs private letters showing friendlier or coordinated intent than public texts; not yet found.",
              "raw_value": "Needs private letters showing friendlier or coordinated intent than public texts; not yet found.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "F4",
              "type": "str",
              "value": "Possible, unproven",
              "raw_value": "Possible, unproven",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
