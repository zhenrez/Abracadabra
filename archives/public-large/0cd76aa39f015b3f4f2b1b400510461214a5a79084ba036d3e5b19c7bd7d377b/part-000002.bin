            },
            {
              "ref": "D5",
              "type": "str",
              "value": "Epistemic counterclaim",
              "raw_value": "Epistemic counterclaim",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E5",
              "type": "str",
              "value": "Fludd distinguishes quantitative mathematical 'shadows' from the inner or essential causes he believes Hermetic/alchemical inquiry reaches.",
