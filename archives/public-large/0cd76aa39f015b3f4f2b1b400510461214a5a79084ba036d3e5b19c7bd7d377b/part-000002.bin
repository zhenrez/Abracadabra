              "raw_value": "HYP-4",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "B5",
              "type": "str",
              "value": "Secret coordinated collaboration / coded joint message",
              "raw_value": "Secret coordinated collaboration / coded joint message",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "C5",
              "type": "str",
              "value": "Kepler and Fludd intentionally divided one larger message/system between public works and staged a dispute.",
              "raw_value": "Kepler and Fludd intentionally divided one larger message/system between public works and staged a dispute.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "D5",
              "type": "str",
              "value": "Would predict advance coordination, shared cipher/key, manuscript cross-dependencies impossible by publication order, or private admission.",
              "raw_value": "Would predict advance coordination, shared cipher/key, manuscript cross-dependencies impossible by publication order, or private admission.",
              "formula": null,
              "formula_attributes": null,
              "style": "19"
            },
            {
              "ref": "E5",
              "type": "str",
              "value": "No positive contemporaneous evidence found so far; present complementarity is insufficient.",
              "raw_value": "No positive contemporaneous evidence found so far; present complementarity is insufficient.",
              "formula": null,
